# ===== Сметчик: настройки. Установщик заполняет этот файл сам, руками править не обязательно. =====

# Токен бота от @BotFather (обязательно)
SMETA_BOT_TOKEN=

# Ваш Telegram ID (узнать: @userinfobot). Администратор: безлимит, /grant, статистика оплат
SMETA_ADMIN_IDS=

# ---- Мини-апп. Телеграм открывает его только по https:// ----
# Адрес, по которому сервер доступен снаружи. Пусто = мини-апп выключен, бот работает без него.
SMETA_WEBAPP_URL=
SMETA_WEBAPP_PORT=8080

# ---- Оплата подписки ----
# Токен платёжного провайдера из @BotFather → Payments (ЮKassa, Сбер и др.).
# Пусто = оплата в Telegram Stars (работает без провайдера).
SMETA_PAYMENT_TOKEN=
# 1 = передавать чек для онлайн-кассы ЮKassa (54-ФЗ), покупатель указывает e-mail
SMETA_PAYMENT_RECEIPT=0
# Код НДС в чеке ЮKassa (признак НДС продавца, НЕ ставка в смете): 1 — без НДС (самозанятый/УСН),
# 6 — НДС 20/120. Для НДС 22 % уточните актуальный код у вашего ОФД/ЮKassa.
SMETA_RECEIPT_VAT_CODE=1

# ---- Модель «захват клиента» (lead-магнит) ----
# 1 = бесплатно считать сметы без лимита; деньги берём на выдаче готовых документов (рекомендуется).
# 0 = старая модель: N бесплатных смет, потом стена.
SMETA_FREE_UNLIMITED=1
# Лимит бесплатных смет (действует только при SMETA_FREE_UNLIMITED=0)
SMETA_FREE_ESTIMATES=3
# 1 = разрешить бесплатным пользователям скачивать документы (по умолчанию 0 — файлы по подписке)
SMETA_FREE_EXPORTS=0
# 0 = подписка выключена, всё бесплатно (например, пока тестируете с друзьями)
SMETA_BILLING=1
# Промокоды: КОД:дней через запятую
SMETA_PROMO=

# ---- Служебное ----
SMETA_DB_PATH=data/smeta.db
SMETA_OFFERS=data/suppliers/demo.csv
SMETA_EXPORT_DIR=data/export
# Если api.telegram.org с сервера недоступен: socks5://user:pass@host:port или http://...
TELEGRAM_PROXY=
