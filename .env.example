# Telegram-бот: создать у @BotFather
BOT_TOKEN=
# Ключ шифрования API-ключей продавцов. Сгенерировать: python -m app.crypto
# ВНИМАНИЕ: если потерять или сменить — все подключённые магазины придётся подключать заново.
FERNET_KEY=

# ИИ: yandex (YandexGPT, по умолчанию) | openai (любой OpenAI-совместимый API) | mock (демо без ИИ)
LLM_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest
# Для LLM_PROVIDER=openai:
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Ваш Telegram ID (через запятую) — доступ к /stats и /grant
ADMIN_IDS=
POLL_INTERVAL_SEC=300
MAX_ITEMS_PER_POLL=20
FREE_MONTHLY_LIMIT=100
DB_PATH=data/app.db
# Если api.telegram.org с сервера работает нестабильно: http://user:pass@host:port или socks5://...
TELEGRAM_PROXY=
