            ? "# cali=efuse\n"
            : "# cali=nominal (калибровки в eFuse нет, милливольты с ошибкой до 10%)\n");
#else
  push_line("# cali=nominal (схема калибровки недоступна в этой сборке IDF)\n");
#endif
#if UTRO_SQ_PIN != 21
  push_line("# ВНИМАНИЕ: меандр теста Б выведен НЕ на GPIO21, как нарисовано в АНАЛОГОВЫЙ-ТРАКТ.md §6.5, потому что GPIO21 на этой плате занят светодиодом. Rc1 паять на вывод из поля sq_pin\n");
#endif
  if (!g_adc_ok) push_line("# ОШИБКА: драйвер АЦП не поднялся, поток невозможен\n");
}

static void push_help(void) {
  push_line("# cmd: s=поток 200Гц, x=стоп, c[N]=калибровка N с (3..60, по умолч. 10)\n");
  push_line("# cmd: r[N]=сырой поток 4000Гц, захват N с в ОЗУ и выгрузка (проверка 50Гц, §6.7)\n");
  push_line("# cmd: q=меандр 0.2Гц вкл/выкл (тест Б §6.5), b=меандр+поток одной командой\n");
  push_line("# cmd: v=заголовок, z=сброс счётчиков сеанса, ?=справка\n");
}

static void push_stat(void) {
  // 480 байт: в худшем случае все счётчики десятизначные, и компилятор это
  // проверяет (-Wformat-truncation). Обрезанная строка статистики - это
  // поле, пропавшее у хоста без признака.
  char buf[480];
  char fs[24], span[24];
  double fs_hz = 0.0, span_s = 0.0;
  if (meas_fs(&fs_hz, &span_s)) {
    fmt_fixed(fs, sizeof fs, (g_mode == MODE_RAW) ? fs_hz : fs_hz / (double)UTRO_DECIM, 3);
    fmt_fixed(span, sizeof span, span_s, 1);
  } else {
    snprintf(fs, sizeof fs, "nan");
    fmt_fixed(span, sizeof span, span_s, 1);
  }
  snprintf(buf, sizeof buf,
           "# stat mode=%s n=%lu t_ms=%lu fs_meas=%s fs_span_s=%s lost=%lu "
           "lost_pool=%lu lost_tx=%lu lost_bad=%lu lost_warm=%lu ovf=%lu "
           "align=%lu skew=%lu drop_conv=%lu ovf_pre=%lu lost_line=%lu txfree=%lu "
           "tot_lost=%lu tot_ovf=%lu\n",
           mode_name(g_mode),
           (unsigned long)g_n_out,
           (unsigned long)(millis() - g_stream_begin_ms),
           fs, span,
           (unsigned long)session_lost_total(),
           (unsigned long)g_lost_pool, (unsigned long)g_lost_tx,
           (unsigned long)g_lost_bad, (unsigned long)g_lost_warm,
           (unsigned long)g_ovf_events, (unsigned long)g_align_err,
           (unsigned long)g_skew, (unsigned long)g_drop_conv,
           (unsigned long)g_ovf_pre,
           (unsigned long)g_lost_line, (unsigned long)tx_free(),
           (unsigned long)(g_tot_lost + session_lost_total()),
           (unsigned long)(g_tot_ovf + g_ovf_events));
  // Если строка не поместилась — она сама себя посчитает в lost_line, и
  // следующая через пять секунд скажет то же самое: счётчики накопительные.
  push_line(buf);
}

// --------------------------------------------------------------------------
// ИЗМЕРЕНИЕ ФАКТИЧЕСКОЙ ЧАСТОТЫ
// --------------------------------------------------------------------------

static void meas_reset(void) {
  g_raw_total = 0;
  g_meas_open = false;
  g_meas_t0_us = g_meas_t1_us = 0;
  g_meas_n0 = g_meas_n1 = 0;
  g_meas_acc_us = 0.0;
  g_meas_acc_n = 0.0;
}

// Пул оказался пуст: момент времени и счётчик отсчётов согласованы.
static void meas_sync(int64_t now_us) {
  if (!g_anchored) return;
  if (!g_meas_open) {
    g_meas_t0_us = g_meas_t1_us = now_us;
    g_meas_n0 = g_meas_n1 = g_raw_total;
    g_meas_open = true;
    return;
  }
  g_meas_t1_us = now_us;
  g_meas_n1 = g_raw_total;
}

// Потеря: интервал до последней отметки был чистым, его можно сохранить,
// а дальше начинается новый.
static void meas_break(void) {
  if (g_meas_open && g_meas_n1 > g_meas_n0 && g_meas_t1_us > g_meas_t0_us) {
    g_meas_acc_n  += (double)(g_meas_n1 - g_meas_n0);
    g_meas_acc_us += (double)(g_meas_t1_us - g_meas_t0_us);
  }
  g_meas_open = false;
}

// Возвращает СЫРУЮ частоту. false — интервал слишком короткий, чтобы число
// было правдой (разрешение отметок около одного периода выборки, значит на
// двух секундах ошибка уже меньше 0.02 %).
static bool meas_fs(double *fs_hz, double *span_s) {
  double n = g_meas_acc_n, us = g_meas_acc_us;
  if (g_meas_open && g_meas_n1 > g_meas_n0 && g_meas_t1_us > g_meas_t0_us) {
    n  += (double)(g_meas_n1 - g_meas_n0);
    us += (double)(g_meas_t1_us - g_meas_t0_us);
  }
  if (span_s) *span_s = us / 1.0e6;
  if (us < 2.0e6 || n <= 0.0) { if (fs_hz) *fs_hz = 0.0; return false; }
  if (fs_hz) *fs_hz = n * 1.0e6 / us;
  return true;
}

// --------------------------------------------------------------------------
// АЦП
// --------------------------------------------------------------------------
// Почему adc_continuous (DMA), а не таймер с прерыванием:
//  - Моменты выборки задаёт делитель самого АЦП, программа в этом не
//    участвует вообще. Ни загрузка процессора, ни USB-стек, ни запись в
//    порт не могут сдвинуть ни один отсчёт. Прерывание по таймеру, даже с
//    IRAM_ATTR, всё равно конкурирует с прерываниями USB и Wi-Fi, и
//    дрожание в десятки микросекунд на 250-микросекундном шаге пришлось бы
//    либо мерить, либо принять на веру.
//  - analogRead внутри прерывания недопустим: он ждёт готовности АЦП в
//    цикле и берёт блокировки.
//  - DMA даёт передискретизацию бесплатно: 4000 Гц в пул, скользящая сумма
//    по 80 в loop(), на выходе 200 Гц.
// Прерывание здесь всё-таки есть — обработчик переполнения пула ниже. Он
// помечен IRAM_ATTR и делает ровно одно присваивание флага: иначе при
// включённой настройке ADC_CONTINUOUS_ISR_IRAM_SAFE он бы падал на
// обращении к флешу. Счётчик событий инкрементирует ЗАДАЧА, а не прерывание:
// volatile на ESP32 не делает ++ атомарным (l32i/addi/s32i), и инкремент из
// прерывания мог бы потеряться при одновременном чтении или сбросе — для
// счётчика, который и есть механизм честного признания потерь, это
// недопустимо. Флаг сбрасывается в handle_overflow ПЕРЕД чисткой пула, так
// что переполнение во время чистки не теряется.

static adc_digi_pattern_config_t g_pattern;  // статический: драйвер копирует, но пусть живёт

static bool IRAM_ATTR on_pool_overflow(adc_continuous_handle_t handle,
                                       const adc_continuous_evt_data_t *edata,
                                       void *user_data) {
  (void)handle; (void)edata; (void)user_data;
  g_resync = true;
  return false;   // будить задачу не нужно: loop() и так опрашивает пул
}

static bool adc_setup(void) {
  adc_continuous_handle_cfg_t hcfg = {};
  hcfg.max_store_buf_size = UTRO_POOL_BYTES;
  hcfg.conv_frame_size    = UTRO_FRAME_BYTES;
  if (adc_continuous_new_handle(&hcfg, &g_adc) != ESP_OK) { g_adc = NULL; return false; }

  g_pattern = adc_digi_pattern_config_t();
  g_pattern.atten     = (uint8_t)UTRO_ADC_ATTEN;
  g_pattern.channel   = (uint8_t)UTRO_ADC_CHANNEL;
  g_pattern.unit      = (uint8_t)ADC_UNIT_1;
  g_pattern.bit_width = (uint8_t)UTRO_ADC_BITS;

  adc_continuous_config_t ccfg = {};
  ccfg.pattern_num    = 1;
  ccfg.adc_pattern    = &g_pattern;
  ccfg.sample_freq_hz = UTRO_RAW_RATE_HZ;
  ccfg.conv_mode      = ADC_CONV_SINGLE_UNIT_1;
  ccfg.format         = ADC_DIGI_OUTPUT_FORMAT_TYPE2;
  if (adc_continuous_config(g_adc, &ccfg) != ESP_OK) return false;

  adc_continuous_evt_cbs_t cbs = {};
  cbs.on_conv_done = NULL;    // не нужен: пул опрашивается из loop()
  cbs.on_pool_ovf  = on_pool_overflow;
  if (adc_continuous_register_event_callbacks(g_adc, &cbs, NULL) != ESP_OK) return false;

  return true;
}

static bool adc_start(void) {
  if (!g_adc_ok) return false;
  if (g_adc_running) return true;
  if (adc_continuous_start(g_adc) != ESP_OK) return false;
  g_adc_running = true;
  g_resync = false;
  return true;
}

static void adc_stop(void) {
  if (!g_adc_ok || !g_adc_running) return;
  drain_pool();            // вычерпываем, пока драйвер ещё работает
  adc_continuous_stop(g_adc);
  g_adc_running = false;
}

// Выбросить всё, что лежит в пуле. Возвращает число ВЫБРОШЕННЫХ БАЙТ —
// прежняя версия ничего не возвращала, и размер дыры приходилось выводить из
// разности двух несогласованных осей. Теперь выброшенное известно напрямую.
static uint32_t drain_pool(void) {
  if (!g_adc_running) return 0;
  static uint8_t scratch[UTRO_READ_BYTES] __attribute__((aligned(4)));
  uint32_t total = 0;
  const uint32_t guard_max = (UTRO_POOL_BYTES / UTRO_READ_BYTES) + 4u;
  for (uint32_t guard = 0; guard < guard_max; guard++) {
    uint32_t got = 0;
    if (adc_continuous_read(g_adc, scratch, UTRO_READ_BYTES, &got, 0) != ESP_OK) break;
    if (got == 0) break;
    total += got;
  }
  return total;
}

static uint32_t axis_hz(void) {
  return (g_mode == MODE_RAW) ? UTRO_RAW_RATE_HZ : UTRO_OUT_RATE_HZ;
}

static uint32_t index_from_clock(void) {
  int64_t dt = esp_timer_get_time() - g_t0_us;
  if (dt < 0) dt = 0;
  return (uint32_t)((dt * (int64_t)axis_hz()) / 1000000);
}

static void anchor_axis(void) {
  g_t0_us = esp_timer_get_time();
  g_n_out = 0;
  g_anchored = true;
  meas_reset();
  char buf[160];
  snprintf(buf, sizeof buf,
           "# begin mode=%s axis_hz=%lu value=%s t_boot_ms=%lu settle_ms=%lu\n",
           mode_name(g_mode), (unsigned long)axis_hz(),
           (g_mode == MODE_RAW) ? "один_отсчёт_АЦП" : "сумма_80",
           (unsigned long)millis(), (unsigned long)UTRO_SETTLE_MS);
  push_line(buf);
  g_stream_begin_ms = millis();
  g_next_stat_ms = g_stream_begin_ms + UTRO_STAT_MS;
}

// Переполнение пула означает, что loop() не успевал больше секунды.
// Поведение драйвера при переполнении зависит от версии IDF: одни версии
// сохраняют старые данные и выбрасывают новые, другие затирают старые.
// Поэтому обработчик не полагается на это вовсе: он выбрасывает пул целиком
// и заново берёт индекс из системного таймера.
//
// Главное отличие от прежней версии: индекс продвигается ВСЕГДА, а размер
// дыры берётся как максимум из двух НЕЗАВИСИМЫХ оценок —
//   по часам: n_now - g_n_out (сколько времени прошло);
//   по пулу:  сколько кадров мы сами вычерпали в мусор, плюс минимум один
//             отсчёт, который не поместился (переполнение означает, что пул
//             был полон).
// Прежнее условие «наращивать только если n_now > g_n_out» молчало ровно
// тогда, когда счётчик отсчётов опережал часы, то есть при любой ошибке
// частоты: дыра в секунду становилась невидимой, индексы шли подряд, и хост
// склеивал две половины записи через пропавшую секунду.
// Точность восстановления индекса примерно +-1 отсчёт на событие: столько
// занимает конвейер между выборкой и чтением из пула (чтения выровнены по
// границе кадра, то есть по 5 мс).
static void handle_overflow(void) {
  // Причины две и считаются они раздельно. Если совпали — учтена каждая.
  bool was_ovf   = g_resync;
  bool was_align = g_resync_align;
  g_resync = false;
  g_resync_align = false;
  if (was_ovf) {
    if (g_anchored) g_ovf_events++;
    else            g_ovf_pre++;
  }
  uint32_t drained = drain_pool();
  // Считаем выброшенное отдельным счётчиком: только здесь чистка пула
  // означает потерю. Чистка перед привязкой оси и при остановке - не
  // потеря, и смешивать их в одном числе значило бы завышать потери.
  g_drop_conv += drained / 4u;
  g_sum = 0;
  g_ring_pos = 0;
  g_ring_fill = 0;
  g_phase = 0;
  g_ema_init = false;
  g_gz_dirty = true;            // блок оценки наводки разорван, он негоден
  meas_break();
  if (!g_anchored) return;      // ось ещё не начиналась, терять нечего

  uint32_t n_now = index_from_clock();
  uint32_t gap_clock = (n_now > g_n_out) ? (n_now - g_n_out) : 0;
  if (g_n_out > n_now + 2u) {
    // Индекс опережает часы больше, чем на точность восстановления. Это не
    // потеря, а рассинхрон осей, и он сам по себе означает, что частота не
    // та, что объявлена. Печатаем отдельно, чтобы не смешивать с дырой.
    uint32_t s = g_n_out - n_now;
    if (s > g_skew) g_skew = s;
  }
  uint32_t per_frame = (g_mode == MODE_RAW) ? UTRO_DECIM : 1u;
  uint32_t gap_pool = (drained / UTRO_FRAME_BYTES) * per_frame + 1u;
  uint32_t gap = (gap_clock > gap_pool) ? gap_clock : gap_pool;

  uint32_t from = g_n_out;
  g_lost_pool += gap;
  g_n_out += gap;

  if (g_mode == MODE_RAW && g_raw_buf != NULL) {
    if (g_raw_gap_n < UTRO_RAW_GAPS) {
      g_raw_gap_at[g_raw_gap_n] = g_raw_len;
      g_raw_gap_lost[g_raw_gap_n] = gap;
      g_raw_gap_n++;
    } else {
      g_raw_gap_over++;
    }
    g_raw_lost_total += gap;
  }

  // Разрыв, видимый как событие, нельзя потерять арифметикой: накопительный
  // счётчик можно не заметить, отдельную строку — нет.
  // reason — ПРИЧИНА разрыва, src — по какой из двух оценок взят его размер.
  // Это разные вещи, и человеку нужны обе: причина говорит, что чинить
  // (ovf - loop() не успевает; align - сломан шаблон сканирования АЦП), а
  // src - насколько доверять числу lost.
  char buf[192];
  snprintf(buf, sizeof buf,
           "# gap n_from=%lu n_to=%lu lost=%lu reason=%s src=%s drained_frames=%lu ovf=%lu align=%lu\n",
           (unsigned long)from, (unsigned long)g_n_out, (unsigned long)gap,
           (was_ovf && was_align) ? "ovf+align" : (was_align ? "align" : "ovf"),
           (gap_clock > gap_pool) ? "clock" : "pool",
           (unsigned long)(drained / UTRO_FRAME_BYTES),
           (unsigned long)g_ovf_events, (unsigned long)g_align_err);
  push_line(buf);
}

// Вычерпать пул, просуммировать, отдать. Возвращает true, если была работа.
static bool pump_adc(void) {
  if (!g_adc_running) return false;
  if (g_mode != MODE_STREAM && g_mode != MODE_CAL && g_mode != MODE_RAW) return false;

  // Пока буфер передачи не разгрузился, пул не трогаем: пусть данные
  // лежат в нём. Два буфера так работают как один длинный, и потеря
  // остаётся возможной только в одном месте — в пуле, где она считается.
  if (g_mode == MODE_STREAM && tx_free() < UTRO_TX_LOW_WATER) return false;

  if (g_resync || g_resync_align) handle_overflow();

  uint32_t now_ms = millis();

  if (!g_settled) {
    if ((int32_t)(now_ms - g_settle_until_ms) < 0) {
      // Установление тракта: читаем и выбрасываем, иначе пул переполнится.
      static uint8_t waste[UTRO_READ_BYTES] __attribute__((aligned(4)));
      uint32_t got = 0;
      if (adc_continuous_read(g_adc, waste, UTRO_READ_BYTES, &got, 0) != ESP_OK) return false;
      if ((int32_t)(now_ms - g_settle_tick_ms) >= 0) {
        g_settle_tick_ms = now_ms + UTRO_SETTLE_TICK_MS;
        uint32_t left = (uint32_t)((int32_t)(g_settle_until_ms - now_ms));
        char buf[96];
        snprintf(buf, sizeof buf, "# settle left_ms=%lu\n", (unsigned long)left);
        push_line(buf);
      }
      return got != 0;
    }
    // Установление закончилось. Чистим пул, чтобы окно суммы началось с
    // границы кадра и не содержало отсчётов из переходного процесса.
    drain_pool();
    g_sum = 0;
    g_ring_pos = 0;
    g_ring_fill = 0;
    g_phase = 0;
    g_settled = true;
    push_line("# settle done\n");
    return true;
  }

  static uint8_t buf[UTRO_READ_BYTES] __attribute__((aligned(4)));
  uint32_t got = 0;
  esp_err_t rc = adc_continuous_read(g_adc, buf, UTRO_READ_BYTES, &got, 0);
  int64_t t_read = esp_timer_get_time();
  if (rc != ESP_OK || got == 0) {
    // Пул пуст. Это и есть согласованная отметка для измерения частоты:
    // последнее прочитанное преобразование произошло только что.
    meas_sync(t_read);
    return false;
  }

  // Кольцевой буфер драйвера байтовый, но все записи в него кратны четырём
  // и его размер кратен четырём, поэтому остатка быть не может. Если он
  // всё же появится, фаза суммирования съедет на всю оставшуюся запись —
  // поэтому не замалчиваем, а считаем и пересинхронизируемся.
  if ((got & 3u) != 0) {
    g_align_err++;
    g_resync_align = true;      // своя причина, не переполнение пула
    got &= ~3u;
  }

  const uint8_t mode_at_start = g_mode;
  for (uint32_t i = 0; i + 4u <= got; i += 4u) {
    if (g_mode != mode_at_start) break;    // режим сменился внутри чтения
    adc_digi_output_data_t *p = (adc_digi_output_data_t *)&buf[i];
    if ((adc_channel_t)UTRO_CONV_CHANNEL(p) != UTRO_ADC_CHANNEL) {
      // Чужой канал в потоке «только ADC1» означает, что сломан шаблон
      // сканирования. Подставлять сюда предыдущее значение значило бы
      // придумать отсчёт; вместо этого объявляем окно суммы недостоверным
      // (его придётся заполнить заново) и считаем потерю.
      g_lost_bad++;
      g_ring_fill = 0;
      g_sum = 0;
      g_ring_pos = 0;
      g_gz_dirty = true;
      meas_break();
      continue;
    }
    feed_raw((uint32_t)UTRO_CONV_DATA(p));
  }
  if (got < UTRO_READ_BYTES) meas_sync(t_read);
  return true;
}

// Один сырой отсчёт: сначала то, что считается по сырому потоку, потом
// скользящая сумма и выдача.
static void feed_raw(uint32_t raw) {
  if (g_mode == MODE_RAW) {
    if (!g_anchored) anchor_axis();
    g_raw_total++;
    raw_store(raw);
    return;
  }
  g_raw_total++;
  if (g_mode == MODE_CAL) cal_feed_raw(raw);

  // Бегущая сумма. Пока окно не заполнено, вычитать НЕЧЕГО: в кольце лежат
  // отсчёты предыдущего окна — другого сеанса или участка до разрыва.
  // Вычитание их из новой суммы оставляет постоянное смещение -Σ(старых) на
  // всю оставшуюся запись, и оно не уходит никогда: дальше каждый шаг
  // вычитает уже свой отсчёт. Поймано прогоном на поддельном пуле — суммы
  // выходили около нуля вместо 80*2048, то есть прибор отдавал бы ровную
  // линию у нуля и выглядел бы как мёртвый тракт при живом.
  if (g_ring_fill < UTRO_SUM_LEN) {
    g_sum += raw;
    g_ring[g_ring_pos] = (uint16_t)raw;
    g_ring_fill++;
  } else {
    g_sum += raw;
    g_sum -= g_ring[g_ring_pos];
    g_ring[g_ring_pos] = (uint16_t)raw;
  }
  g_ring_pos++;
  if (g_ring_pos >= UTRO_SUM_LEN) g_ring_pos = 0;

  if (++g_phase < UTRO_DECIM) return;
  g_phase = 0;

  if (g_ring_fill < UTRO_SUM_LEN) {
    // Окно суммы ещё не заполнено: после разрыва на это уходит 80 сырых
    // отсчётов, то есть три точки выходной сетки (20, 40, 60) выдать нечем,
    // а четвёртая (80) уже полная. Отдавать неполную сумму нельзя: это был
    // бы отсчёт с другим коэффициентом передачи, то есть другой прибор. Но
    // и молчать нельзя — ось времени идёт, значит это потеря, и она обязана
    // быть видна как разрыв индексов.
    if (g_anchored) {
      g_lost_warm++;
      g_n_out++;
    }
    return;
  }
  if (!g_anchored) anchor_axis();
  emit_out(g_sum);
}

static void emit_out(uint32_t v) {
  if (g_mode == MODE_STREAM) {
    char line[28];
    int len = snprintf(line, sizeof line, "%lu,%lu\n",
                       (unsigned long)g_n_out, (unsigned long)v);
    if (len > 0 && !tx_push(line, (size_t)len)) {
      // Не должно случаться: выше стоит порог UTRO_TX_LOW_WATER, которого
      // хватает на целое чтение. Если счётчик не ноль — сломана эта
      // арифметика, а не порт.
      g_lost_tx++;
    }
  } else if (g_mode == MODE_CAL) {
    cal_feed_out(v, g_n_out);
  }
  g_n_out++;
}

// --------------------------------------------------------------------------
// КАЛИБРОВКА
// --------------------------------------------------------------------------
// Смысл команды: до укладки плёнки под матрас ответить на вопрос «тракт
// жив?». Мёртвый тракт выглядит правдоподобно — ровная линия на середине
// диапазона, — и обнаружить его потом, по десяти минутам бесполезной
// записи, дороже.
//
// Что считается и ГДЕ:
//  - по СЫРОМУ потоку 4000 Гц: среднее, СКО, минимум, максимум, число
//    отсчётов, прижатых к краям диапазона, и амплитуда наводки 50 Гц.
//    Именно здесь, а не на выходном потоке: скользящая сумма по 80 давит
//    полный СКО белого шума в 8.94 раза и имеет на 50 Гц ТОЧНЫЙ НУЛЬ. Оценка наводки,
//    снятая с выходного потока, показала бы ноль при любой наводке — то
//    есть молчала бы ровно тогда, когда должна кричать.
//  - по ВЫХОДНОМУ потоку 200 Гц: среднее, СКО, размах и дрейф (среднее
//    второй половины окна минус среднее первой). Дрейф прямо показывает,
//    установился ли зарядовый усилитель.
//  - отношение СКО сырого к СКО выходного (noise_gain): прямая проверка
//    подавления ПОЛНОГО СКО в sqrt(80) = 8.94 раза. Бюджет шума §2.3 на этом
//    числе НЕ стоит — шум в полосе пульса 4–20 Гц сумма почти не снижает
//    (выигрыш 11 %, см. шапку файла); noise_gain проверяет другое и не менее
//    нужное: что шум действительно белый и что в сыром потоке не сидит линия
//    на 50/100/150 Гц. Число читается так:
//      около 8.94 — шум белый, подавление ровно расчётное;
//      БОЛЬШЕ 8.94 — часть энергии сырого потока сидит в нулях гребёнки,
//        то есть на 50/100/150 Гц: это наводка, и её видно независимо от
//        оценки по Гёрцелю (проверено прогоном: наводка 3 LSB при шуме
//        2 LSB даёт noise_gain 13.2 вместо 8.94);
//      МЕНЬШЕ 8.94 — либо шум не белый, либо в сигнале есть медленная
//        составляющая (дыхание, дрейф), которую сумма по построению не
//        давит. При человеке на матрасе так и будет, поэтому сверять с
//        8.94 имеет смысл на ПУСТОЙ постели.
// Границы половин окна берутся по ВРЕМЕННОЙ координате, а не по числу
// принятых отсчётов: при потере «половины» по счётчику перестают быть
// половинами по времени, и дрейф — единственная прямая проверка
// установления — начинает мерить не то.

static void cal_begin(uint32_t seconds) {
  if (seconds < UTRO_CAL_MIN_S) seconds = UTRO_CAL_MIN_S;
  if (seconds > UTRO_CAL_MAX_S) seconds = UTRO_CAL_MAX_S;
  g_cal_target = seconds * UTRO_OUT_RATE_HZ;
  g_cal_n = 0;
  g_cal_mean = 0.0;
  g_cal_m2 = 0.0;
  g_cal_min = 0xFFFFFFFFu;
  g_cal_max = 0;
  g_cal_first = 0.0;
  g_cal_second = 0.0;
  g_cal_nf = 0;
  g_cal_ns = 0;

  g_calr_n = 0;
  g_calr_mean = 0.0;
  g_calr_m2 = 0.0;
  g_calr_min = 0xFFFFFFFFu;
  g_calr_max = 0;
  g_calr_clip_lo = 0;
  g_calr_clip_hi = 0;
  g_calr_sq = 0.0;

  for (int k = 0; k < UTRO_GZ_FREQS; k++) {
    g_gz_coef[k] = 2.0 * cos(2.0 * kPi * kGzFreq[k] / (double)UTRO_RAW_RATE_HZ);
    g_gz_s1[k] = g_gz_s2[k] = 0.0;
    g_gz_sum[k] = g_gz_max[k] = 0.0;
  }
  g_gz_blk_n = 0;
  g_gz_blocks = 0;
  g_gz_dropped = 0;
  // Первый блок отбрасываем всегда: в нём устанавливается оценка постоянной
  // составляющей, и её переходный процесс протекает в бины 49.5 и 50.5 Гц.
  g_gz_dirty = true;
  g_ema_init = false;

  char buf[128];
  snprintf(buf, sizeof buf, "# cal start sec=%lu n=%lu settle_ms=%lu blocks_1s=%lu\n",
           (unsigned long)seconds, (unsigned long)g_cal_target,
           (unsigned long)UTRO_SETTLE_MS, (unsigned long)(seconds - 1u));
  push_line(buf);
}

static void cal_feed_raw(uint32_t raw) {
  g_calr_n++;
  double x = (double)raw;
  double d = x - g_calr_mean;
  g_calr_mean += d / (double)g_calr_n;
  g_calr_m2 += d * (x - g_calr_mean);
  if (raw < g_calr_min) g_calr_min = raw;
  if (raw > g_calr_max) g_calr_max = raw;
  // Прижатие к краям диапазона — это клиппинг. Он не «ухудшает» сигнал, он
  // рождает гармоники дыхания прямо в полосе 4–20 Гц, то есть создаёт
  // ЛОЖНЫЙ пульс. Поэтому считается отдельно и даёт отказ, а не замечание.
  if (raw <= 1u) g_calr_clip_lo++;
  if (raw >= UTRO_ADC_MAX - 1u) g_calr_clip_hi++;

  if (!g_ema_init) { g_ema = x; g_ema_init = true; }
  else g_ema += (x - g_ema) / UTRO_EMA_K;
  double v = x - g_ema;
  g_calr_sq += v * v;

  for (int k = 0; k < UTRO_GZ_FREQS; k++) {
    double s0 = v + g_gz_coef[k] * g_gz_s1[k] - g_gz_s2[k];
    g_gz_s2[k] = g_gz_s1[k];
    g_gz_s1[k] = s0;
  }
  if (++g_gz_blk_n < UTRO_GZ_BLOCK) return;

  if (!g_gz_dirty) {
    for (int k = 0; k < UTRO_GZ_FREQS; k++) {
      double p = g_gz_s1[k] * g_gz_s1[k] + g_gz_s2[k] * g_gz_s2[k]
                 - g_gz_coef[k] * g_gz_s1[k] * g_gz_s2[k];
      if (p < 0.0) p = 0.0;
      double a = 2.0 * sqrt(p) / (double)UTRO_GZ_BLOCK;
      g_gz_sum[k] += a;
      if (a > g_gz_max[k]) g_gz_max[k] = a;
    }
    g_gz_blocks++;
  } else {
    g_gz_dropped++;
  }
  for (int k = 0; k < UTRO_GZ_FREQS; k++) { g_gz_s1[k] = 0.0; g_gz_s2[k] = 0.0; }
  g_gz_blk_n = 0;
  g_gz_dirty = false;
}

static void cal_feed_out(uint32_t v, uint32_t idx) {
  g_cal_n++;
  double x = (double)v;
  double d = x - g_cal_mean;
  g_cal_mean += d / (double)g_cal_n;
  g_cal_m2 += d * (x - g_cal_mean);
  if (v < g_cal_min) g_cal_min = v;
  if (v > g_cal_max) g_cal_max = v;
  // Половины — по времени (idx), а не по номеру принятого отсчёта.
  if (idx < g_cal_target / 2u) { g_cal_first += x;  g_cal_nf++; }
  else                         { g_cal_second += x; g_cal_ns++; }
}

static void cal_report(void) {
  const double os = (double)UTRO_SUM_LEN;
  char a[24], b[24], c[24], d[24], e[24], f[24];
  // 512 байт, а не 256: русские строки в UTF-8 по два байта на букву, и
  // обрезанное предупреждение - это испорченная диагностика, причём обрезок
  // может разорвать букву посередине. Компилятор проверяет этот размер
  // (-Wformat-truncation), поэтому ошибка не доживёт до платы.
  char buf[512];

  double fs_raw = 0.0, fs_span = 0.0;
  bool fs_ok = meas_fs(&fs_raw, &fs_span);

  // --- что измерено ---
  fmt_fixed(a, sizeof a, fs_ok ? fs_raw : NAN, 3);
  fmt_fixed(b, sizeof b, fs_ok ? fs_raw / (double)UTRO_DECIM : NAN, 3);
  fmt_fixed(c, sizeof c, fs_span, 1);
  snprintf(buf, sizeof buf,
           "# cal n_out=%lu n_raw=%lu fs_raw_nom=%lu fs_raw_meas=%s fs_out_meas=%s fs_span_s=%s\n",
           (unsigned long)g_cal_n, (unsigned long)g_calr_n,
           (unsigned long)UTRO_RAW_RATE_HZ, a, b, c);
  push_line(buf);

  // --- потери: печатаются ВСЕГДА, даже когда их нет ---
  snprintf(buf, sizeof buf,
           "# cal lost=%lu lost_pool=%lu lost_bad=%lu lost_warm=%lu ovf=%lu "
           "ovf_pre=%lu align=%lu blocks_used=%lu blocks_dropped=%lu lost_line=%lu\n",
           (unsigned long)session_lost_total(), (unsigned long)g_lost_pool,
           (unsigned long)g_lost_bad, (unsigned long)g_lost_warm,
           (unsigned long)g_ovf_events, (unsigned long)g_ovf_pre,
           (unsigned long)g_align_err,
           (unsigned long)g_gz_blocks, (unsigned long)g_gz_dropped,
           (unsigned long)g_lost_line);
  push_line(buf);

  // --- сырой поток ---
  double rmean = g_calr_mean;
  double rvar  = (g_calr_n > 1) ? (g_calr_m2 / (double)(g_calr_n - 1)) : 0.0;
  double rsd   = (rvar > 0.0) ? sqrt(rvar) : 0.0;
  double rmin  = (g_calr_n > 0) ? (double)g_calr_min : 0.0;
  double rmax  = (g_calr_n > 0) ? (double)g_calr_max : 0.0;
  double rpp   = rmax - rmin;
  fmt_fixed(a, sizeof a, rmean, 2);
  fmt_fixed(b, sizeof b, rsd, 3);
  fmt_fixed(c, sizeof c, rmin, 0);
  fmt_fixed(d, sizeof d, rmax, 0);
  fmt_fixed(e, sizeof e, rpp, 0);
  snprintf(buf, sizeof buf,
           "# cal raw mean=%s sd=%s min=%s max=%s pp=%s clip_lo=%lu clip_hi=%lu\n",
           a, b, c, d, e,
           (unsigned long)g_calr_clip_lo, (unsigned long)g_calr_clip_hi);
  push_line(buf);

  // --- выходной поток, в единицах ОДНОГО отсчёта АЦП ---
  double mean = g_cal_mean / os;
  double var  = (g_cal_n > 1) ? (g_cal_m2 / (double)(g_cal_n - 1)) : 0.0;
  double sd   = (var > 0.0) ? sqrt(var) / os : 0.0;
  double vmin = (g_cal_n > 0) ? (double)g_cal_min / os : 0.0;
  double vmax = (g_cal_n > 0) ? (double)g_cal_max / os : 0.0;
  double pp   = vmax - vmin;
  double drift = 0.0;
  if (g_cal_nf > 0 && g_cal_ns > 0) {
    drift = (g_cal_second / (double)g_cal_ns - g_cal_first / (double)g_cal_nf) / os;
  }
  fmt_fixed(a, sizeof a, mean, 2);
  fmt_fixed(b, sizeof b, sd, 4);
  fmt_fixed(c, sizeof c, pp, 2);
  fmt_fixed(d, sizeof d, drift, 3);
  fmt_fixed(e, sizeof e, (sd > 0.0) ? rsd / sd : NAN, 2);
  fmt_fixed(f, sizeof f, kNoiseGain, 2);
  snprintf(buf, sizeof buf,
           "# cal out mean=%s sd=%s pp=%s drift=%s noise_gain=%s noise_gain_expected=%s\n",
           a, b, c, d, e, f);
  push_line(buf);

  // --- милливольты ---
  int raw_mean = (int)(rmean + 0.5);
  int mv_mean = raw_to_mv(raw_mean);
  double slope = mv_per_lsb(raw_mean);
  fmt_fixed(a, sizeof a, rsd * slope, 3);
  fmt_fixed(b, sizeof b, rpp * slope, 2);
  fmt_fixed(c, sizeof c, slope * 1000.0, 2);
  snprintf(buf, sizeof buf,
           "# cal mv mean=%d raw_sd=%s raw_pp=%s uv_per_lsb=%s\n", mv_mean, a, b, c);
  push_line(buf);

  // --- наводка 50 Гц по сырому потоку ---
  double m_mean = 0.0, m_max = 0.0;
  int m_best = 1;
  if (g_gz_blocks > 0) {
    for (int k = 0; k < UTRO_GZ_FREQS; k++) {
      double mu = g_gz_sum[k] / (double)g_gz_blocks;
      if (mu > m_mean) { m_mean = mu; m_best = k; }
      if (g_gz_max[k] > m_max) m_max = g_gz_max[k];
    }
  }
  double rms_raw = (g_calr_n > 0) ? sqrt(g_calr_sq / (double)g_calr_n) : 0.0;
  // Доля наводки по §6.7. Определение берётся из кода самого §6.7
  // БУКВАЛЬНО: там доля печатается как amp50/(rms*1.414), то есть амплитуда
  // 50 Гц, делённая на размах rms*sqrt(2). Прежняя версия делила на rms БЕЗ
  // sqrt(2), хотя соседний комментарий утверждал обратное: доля выходила в
  // 1.414 раза больше, чем у документа, порог 0.3 срабатывал при настоящей
  // доле 0.21, и прибор гнал оператора чинить механику на исправном тракте.
  // Проверка, дающая ложную тревогу, кончается тем, что оператор срезает G и
  // теряет пульс - то есть ценой того самого измерения, ради которого стенд
  // существует.
  double m_frac = (rms_raw > 0.0) ? m_mean / (rms_raw * sqrt(2.0)) : 0.0;
  // Два узла, два числа. mv_mean — милливольты НА ВЫВОДЕ АЦП (так это поле
  // названо и описано в §6.7 п.1 и п.4, имя не меняем). mv_stage2 — та же
  // наводка, приведённая к ВЫХОДУ КАСКАДА 2, где бюджет §2.3 и задан: АЦП
  // видит этот узел через H2(50) = 0.550, поэтому делим, а не умножаем.
  // Без второго числа первое нечем сравнить с «300 мВ», и именно на этой
  // подмене узлов прежний порог прошивки был вдвое мягче бюджета.
  double m_mv_adc = m_mean * slope;
  double m_mv_st2 = m_mv_adc / UTRO_H2_AT_MAINS;
  fmt_fixed(a, sizeof a, m_mean, 3);
  fmt_fixed(b, sizeof b, m_max, 3);
  fmt_fixed(c, sizeof c, m_mv_adc, 2);
  fmt_fixed(d, sizeof d, m_frac, 3);
  fmt_fixed(e, sizeof e, kGzFreq[m_best], 1);
  fmt_fixed(f, sizeof f, rms_raw, 3);
  snprintf(buf, sizeof buf,
           "# cal mains50 lsb_mean=%s lsb_max=%s mv_mean=%s frac=%s at_hz=%s raw_rms=%s blocks=%lu\n",
           a, b, c, d, e, f, (unsigned long)g_gz_blocks);
  push_line(buf);
  fmt_fixed(a, sizeof a, m_mv_st2, 1);
  fmt_fixed(b, sizeof b, 100.0 * m_mean / UTRO_MAINS_AMP_STOP_LSB, 1);
  snprintf(buf, sizeof buf,
           "# cal mains50 mv_stage2=%s budget_mv=%d budget_used_pct=%s lsb_good=%d lsb_stop=%d (§4.2: АЦП видит выход каскада 2 через H2(50)=0.550)\n",
           a, (int)UTRO_MAINS_BUDGET_MV, b,
           (int)UTRO_MAINS_AMP_GOOD_LSB, (int)UTRO_MAINS_AMP_STOP_LSB);
  push_line(buf);

  // --- выводы ---
  // Пороги ниже взяты из АНАЛОГОВЫЙ-ТРАКТ.md (§2.3 бюджет размаха и наводки,
  // §6.6 рабочий размах, §6.7 доля 50 Гц), но сами эти числа в документе
  // РАСЧЁТНЫЕ: ни одно не проверено на собранном усилителе. ИЗМЕРИТЬ
  // осциллографом, сверяя с этим выводом.
  bool quiet = true;

  // Потеря отсчётов делает недостоверным ВСЁ выше: СКО и размах занижаются
  // пропорционально доле потерянного, а оценка наводки теряет блоки.
  // Приёмочный тест, который не умеет провалиться, бесполезен.
  if (session_losses() || g_gz_dropped > 1u) {
    snprintf(buf, sizeof buf,
             "# cal ОТКАЗ: калибровка потеряла %lu отсчётов (переполнений пула %lu, негодных блоков оценки сети %lu). Результат недостоверен: СКО и размах занижены, наводка посчитана не по всему окну. Повторите калибровку.\n",
             (unsigned long)session_lost_total(), (unsigned long)g_ovf_events,
             (unsigned long)(g_gz_dropped > 1u ? g_gz_dropped - 1u : 0u));
    push_line(buf);
    quiet = false;
  }
  if (g_ovf_pre > 0) {
    // Данные калибровки от этого не пострадали: до привязки оси всё
    // выбрасывается намеренно. Но пул переполнялся, значит loop() не
    // успевал, и в десятиминутной записи это станет настоящей потерей.
    snprintf(buf, sizeof buf,
             "# cal ВНИМАНИЕ: пул переполнялся %lu раз ДО начала измерения (в ожидании установления). На числа ниже это не влияет, но loop() не успевает вычерпывать пул: в записи 's' будут потери. Проверьте, что в порт не пишет никто, кроме прошивки, и что лог ядра выключен.\n",
             (unsigned long)g_ovf_pre);
    push_line(buf);
    quiet = false;
  }
  if (!fs_ok) {
    push_line("# cal ВНИМАНИЕ: частота не измерена - интервал без потерь короче 2 с. Числа ниже отнесены к НОМИНАЛЬНОЙ частоте, то есть могут быть смещены.\n");
    quiet = false;
  } else {
    double rel = fs_raw / (double)UTRO_RAW_RATE_HZ - 1.0;
    if (rel < 0.0) rel = -rel;
    if (rel > 0.001) {
      fmt_fixed(a, sizeof a, rel * 100.0, 3);
      snprintf(buf, sizeof buf,
               "# cal ВНИМАНИЕ: измеренная частота отличается от номинальной на %s %%. Все частоты, посчитанные хостом по номиналу, смещены на столько же. Передавайте в analyze_window fs_meas.\n", a);
      push_line(buf);
      quiet = false;
    }
  }
  if (g_calr_n == 0) {
    push_line("# cal ОТКАЗ: ни одного сырого отсчёта не получено. Драйвер АЦП не отдаёт данные.\n");
    quiet = false;
  }
  if (g_calr_clip_lo + g_calr_clip_hi > 0) {
    snprintf(buf, sizeof buf,
             "# cal ОТКАЗ: %lu отсчётов прижаты к краям диапазона (к нулю %lu, к %lu - %lu). Это клиппинг: он рождает гармоники дыхания прямо в полосе пульса 4-20 Гц, то есть даёт ЛОЖНЫЙ пульс, а не просто шум. Уменьшите G (§6.6).\n",
             (unsigned long)(g_calr_clip_lo + g_calr_clip_hi),
             (unsigned long)g_calr_clip_lo, (unsigned long)UTRO_ADC_MAX,
             (unsigned long)g_calr_clip_hi);
    push_line(buf);
    quiet = false;
  }
  if (rmean < 0.03 * (double)UTRO_ADC_MAX || rmean > 0.97 * (double)UTRO_ADC_MAX) {
    push_line("# cal ВНИМАНИЕ: смещение упёрто в шину питания. Выход усилителя должен сидеть примерно на середине диапазона (~2048), иначе сигнал обрежется с одной стороны (§3.1).\n");
    quiet = false;
  }
  // Порог по СЫРОМУ СКО: по §2.3 ожидается около 2 LSB RMS (ИЗМЕРИТЬ).
  // На выходном потоке сумма давит полный СКО в 8.94 раза, и прежний порог 0.5,
  // применённый к выходному СКО, сработал бы на живом тракте.
  if (rsd < 0.3) {
    push_line("# cal ВНИМАНИЕ: шума нет совсем. У живого АЦП с подключённым высокоимпедансным входом СКО сырых отсчётов около 2 LSB и нулевым не бывает: похоже, вход ни к чему не подключён или усилитель не питается.\n");
    quiet = false;
  }
  if (rpp > UTRO_PP_LINEAR_MAX) {
    push_line("# cal ОТКАЗ: размах вышел за линейный рабочий диапазон +-1200 мВ (3170 кодов, §2.3). Запись будет с клиппингом. Уменьшите G по §6.6.\n");
    quiet = false;
  } else if (rpp > UTRO_PP_HIGH) {
    push_line("# cal ВНИМАНИЕ: размах выше приемлемого по §6.6 (1200..2400 кодов, цель 1850 = амплитуда дыхания 700 мВ = 58 % рабочих +-1200 мВ). При 2400 кодах бюджет §2.3 исчерпан вместе с 50 Гц, Vos и дрейфом. Уменьшите G.\n");
    quiet = false;
  } else if (rpp < UTRO_PP_LOW) {
    // Не ВНИМАНИЕ: на пустой постели (шаг 2 порядка работы) малый размах —
    // это норма, а не неисправность. Сообщаем мягко, с условием.
    push_line("# cal примечание: размах меньше 1200 кодов. Если это запись С ЧЕЛОВЕКОМ на матрасе - усиление мало, новый G = текущий * 1850 / этот размах (§6.6). Если постель пуста - так и должно быть.\n");
  }
  // Наводка: порог в СЫРЫХ КОДАХ, как задано в §6.7 п.3, а не в
  // милливольтах на стороне АЦП против бюджета на выходе каскада 2 - см.
  // пояснение у UTRO_MAINS_AMP_STOP_LSB. Милливольты печатаются обеими
  // сторонами выше, чтобы расход бюджета был виден числом.
  if (m_mean > UTRO_MAINS_AMP_STOP_LSB) {
    fmt_fixed(a, sizeof a, m_mean, 0);
    fmt_fixed(b, sizeof b, m_mv_st2, 0);
    // Текст разбит на три строки намеренно: в общий буфер 512 байт он
    // целиком не влезает, а обрезанное предупреждение рвёт букву UTF-8
    // посередине. Форматируется только первая строка, остальные статические.
    snprintf(buf, sizeof buf,
             "# cal ОТКАЗ: наводка 50 Гц %s кодов амплитуды - на выходе каскада 2 это %s мВ против бюджета 300 мВ (§2.3), и по §4.2 это ГРАНИЦА ЛИНЕЙНОСТИ (218 кодов).\n",
             a, b);
    push_line(buf);
    push_line("# cal ОТКАЗ: каскад 2 уже ограничивает, а ограничение рождает гармоники в полосе 4-20 Гц, то есть ЛОЖНЫЙ пульс, а не просто шум: ни гребёнка 20 мс, ни ФНЧ в dsp.py этого не восстановят.\n");
    push_line("# cal ОТКАЗ: чинить механику по §4.1 (экран плёнки, питание от повербанка и ноутбук на батарее, укоротить и закрепить кабель, разнести от сетевой проводки); цифра не поможет. Усиление НЕ уменьшать: допуск по наводке, приведённый ко входу, масштабируется как 1/G, то есть снижение G делает хуже (§4.2).\n");
    quiet = false;
  } else if (m_mean > UTRO_MAINS_AMP_GOOD_LSB) {
    fmt_fixed(a, sizeof a, m_mean, 0);
    fmt_fixed(b, sizeof b, m_mv_st2, 0);
    snprintf(buf, sizeof buf,
             "# cal ВНИМАНИЕ: наводка 50 Гц %s кодов амплитуды (%s мВ на выходе каскада 2). По §6.7 п.3 хорошо - до 100 кодов, СТОП - выше 218. Запас к границе линейности меньше двух раз: порядок мер §4.1, после каждой меры перезамер 'r 10'.\n",
             a, b);
    push_line(buf);
    quiet = false;
  }
  // Доля §6.7 сравнивает амплитуду 50 Гц с размахом сырого потока
  // (СКО*sqrt(2)), а на пустой постели это СКО — почти целиком собственный
  // шум АЦП (около 2 LSB). Тогда порог 0.3 требовал бы наводки меньше
  // 0.85 LSB = 0.6 мВ, то есть был бы в сотни раз жёстче порога в кодах из
  // §6.7 п.3 (100 LSB) и давал бы ложную тревогу на исправном тракте —
  // ровно то, что гонит оператора срезать усиление и терять пульс. Поэтому
  // доля проверяется только там, где наводка значима в абсолютных единицах,
  // и порог значимости взят не нами, а из §6.7 п.3: 100 кодов. Выше 218 уже
  // отказ, поэтому доля остаётся осмысленной ровно в коридоре 100..218, где
  // она и отвечает на вопрос «наводка — главное, что есть в записи?».
  if (m_frac > UTRO_MAINS_FRAC_MAX && m_mean > UTRO_MAINS_AMP_GOOD_LSB) {
    fmt_fixed(a, sizeof a, m_frac, 2);
    snprintf(buf, sizeof buf,
             "# cal ВНИМАНИЕ: доля 50 Гц в сыром потоке %s, по §6.7 выше 0.3 означает, что наводка - главное, что есть в записи. Порядок мер - §4.1, после каждой меры перезамер командой 'r 10'.\n", a);
    push_line(buf);
    quiet = false;
  }
  // Дрейф: порога нет, потому что честного порога нет. После 46 с ожидания
  // по §2.4 остаётся около 1 % переходного процесса; какой это размах в
  // кодах — зависит от того, насколько тракт был выведен из равновесия, а
  // это неизвестно. Печатаем число и правило.
  {
    double adr = drift < 0.0 ? -drift : drift;
    if (adr > 20.0) {
      fmt_fixed(a, sizeof a, drift, 1);
      snprintf(buf, sizeof buf,
               "# cal примечание: дрейф за окно %s кодов. По §2.4 доминирующая постоянная времени 10.1 с; большой дрейф значит, что плёнку недавно задели или питание включено меньше 90 с назад. Подождите и повторите.\n", a);
      push_line(buf);
    }
  }
  if (quiet) {
    push_line("# cal тракт похож на живой. Это НЕ доказательство, что сигнал плёнки проходит: доказательство даст только analyze_window на записи с человеком, плюс тест Б ('b') для проверки коэффициента передачи.\n");
  }
  push_line("# cal end\n");
  session_stop(true);
}

// --------------------------------------------------------------------------
// СЫРОЙ ПОТОК 4000 Гц
// --------------------------------------------------------------------------
// Зачем: обязательная проверка 50 Гц (§6.7) выполняется ТОЛЬКО на сыром
// потоке. На выходном потоке скользящая сумма по 80 имеет на 50 Гц точный
// нуль — проверка показала бы «наводки нет» при любой наводке.
//
// Почему захват в ОЗУ, а не стрим: 4000 строк в секунду по 11 байт — это
// 44 кБ/с, а провод 460800 бод даёт 46 кБ/с. Стрим работал бы на границе и
// терял отсчёты в зависимости от того, чем является Serial в этой сборке.
// Терять отсчёты в проверке наводки нельзя: пропуск сдвигает фазу и
// занижает оценку. 10 с * 4000 Гц * 2 байта = 80 кБ берутся из кучи на
// время захвата и возвращаются после выгрузки.
//
// Формат выгрузки — тот же, что у основного потока: "<индекс>,<значение>".
// Индекс здесь считает СЫРЫЕ отсчёты (шаг 1/4000 с), значение — один отсчёт
// АЦП, 0..4095. Фрагмент из §6.7 читает файл как столбец чисел, поэтому
// перед ним нужна одна строчка на Python; она печатается прямо в выгрузке,
// чтобы человек не угадывал.

static void raw_begin(uint32_t seconds) {
  if (seconds < 1u) seconds = 1u;
  if (seconds > UTRO_RAW_MAX_S) seconds = UTRO_RAW_MAX_S;
  if (g_raw_buf != NULL) { free(g_raw_buf); g_raw_buf = NULL; }
  uint32_t want = seconds * UTRO_RAW_RATE_HZ;
  uint32_t cap = want;
  while (cap >= UTRO_RAW_RATE_HZ) {
    g_raw_buf = (uint16_t *)malloc((size_t)cap * sizeof(uint16_t));
    if (g_raw_buf != NULL) break;
    cap /= 2u;
  }
  if (g_raw_buf == NULL) {
    push_line("# err сырой захват: не хватило памяти даже на одну секунду (нужно 8 кБ). Освободите кучу или соберите без PSRAM-аллокаций.\n");
    g_raw_cap = 0;
    session_stop(true);
    return;
  }
  g_raw_cap = cap;
  g_raw_len = 0;
  g_raw_gap_n = 0;
  g_raw_gap_over = 0;
  g_raw_lost_total = 0;
  char buf[192];
  snprintf(buf, sizeof buf,
           "# raw start sec_requested=%lu sec_actual=%lu n=%lu fs_nom=%lu bytes=%lu settle_ms=%lu\n",
           (unsigned long)seconds, (unsigned long)(cap / UTRO_RAW_RATE_HZ),
           (unsigned long)cap, (unsigned long)UTRO_RAW_RATE_HZ,
           (unsigned long)(cap * 2u), (unsigned long)UTRO_SETTLE_MS);
  push_line(buf);
  if (cap < want) {
    push_line("# raw ВНИМАНИЕ: памяти хватило не на всё запрошенное время, захват укорочен (см. sec_actual).\n");
  }
}

static void raw_store(uint32_t raw) {
  if (g_raw_buf == NULL) return;
  if (g_raw_len < g_raw_cap) g_raw_buf[g_raw_len++] = (uint16_t)raw;
  g_n_out++;
}

static void raw_finish(void) {
  // Частоту измеряем ДО остановки АЦП: после остановки отметок больше не
  // будет, а в выгрузке она обязана быть — по ней считается спектр.
  g_raw_fs_span = 0.0;
  if (!meas_fs(&g_raw_fs_meas, &g_raw_fs_span)) g_raw_fs_meas = 0.0;
  adc_stop();
  g_mode = MODE_DUMP;
  g_dump_i = 0;
  g_dump_g = 0;
  g_dump_off = 0;
  g_dump_next_ms = millis();

  char buf[352];
  char a[24], b[24];
  fmt_fixed(a, sizeof a, (g_raw_fs_meas > 0.0) ? g_raw_fs_meas : NAN, 3);
  fmt_fixed(b, sizeof b, g_raw_fs_span, 1);
  snprintf(buf, sizeof buf,
           "# raw begin n=%lu fs_nom=%lu fs_meas=%s fs_span_s=%s lost=%lu gaps=%lu gaps_unlogged=%lu ovf=%lu\n",
           (unsigned long)g_raw_len, (unsigned long)UTRO_RAW_RATE_HZ, a, b,
           (unsigned long)g_raw_lost_total, (unsigned long)g_raw_gap_n,
           (unsigned long)g_raw_gap_over, (unsigned long)g_ovf_events);
  push_line(buf);
  push_line("# raw формат: <индекс сырого отсчёта>,<код АЦП 0..4095>; шаг индекса = 1/fs_meas\n");
  push_line("# raw для §6.7: raw=[float(l.split(',')[1]) for l in open('raw4k.txt') if l[:1].isdigit()]\n");
  push_line("# raw затем: goertzel(raw, fs_meas, 50.0) — именно fs_meas, не 4000.0\n");
  if (g_raw_lost_total > 0) {
    push_line("# raw ОТКАЗ: в захвате есть разрывы (строки '# raw gap'). Оценка наводки по такому куску занижена: пропуск сдвигает фазу. Повторите захват.\n");
  }
}

// Выгрузка идёт порциями: 40 000 строк в кольцо на 8 кБ сразу не влезут.
static void raw_dump_step(void) {
  if (g_mode != MODE_DUMP) return;
  while (tx_free() > 64u) {
    if (g_dump_g < g_raw_gap_n && g_raw_gap_at[g_dump_g] == g_dump_i) {
      char buf[96];
      snprintf(buf, sizeof buf, "# raw gap at_index=%lu lost=%lu\n",
               (unsigned long)(g_dump_i + g_dump_off),
               (unsigned long)g_raw_gap_lost[g_dump_g]);
      if (!tx_push(buf, strlen(buf))) return;   // не влезло — в следующий раз
      g_dump_off += g_raw_gap_lost[g_dump_g];
      g_dump_g++;
      continue;
    }
    if (g_dump_i >= g_raw_len) {
      char buf[160];
      snprintf(buf, sizeof buf, "# raw end n=%lu lost=%lu\n",
               (unsigned long)g_raw_len, (unsigned long)g_raw_lost_total);
      if (!tx_push(buf, strlen(buf))) return;
      if (g_raw_buf != NULL) { free(g_raw_buf); g_raw_buf = NULL; g_raw_cap = 0; }
      g_mode = MODE_IDLE;
      g_anchored = false;
      g_settled = false;
      return;
    }
    char line[28];
    int len = snprintf(line, sizeof line, "%lu,%u\n",
                       (unsigned long)(g_dump_i + g_dump_off),
                       (unsigned)g_raw_buf[g_dump_i]);
    if (len <= 0 || !tx_push(line, (size_t)len)) return;
    g_dump_i++;
  }
}

// --------------------------------------------------------------------------
// КАЛИБРОВОЧНЫЙ МЕАНДР (тест Б, §6.5)
// --------------------------------------------------------------------------
// Меандр 0.2 Гц через Rc1/Rc2/Ccal инжектирует во входной узел известный
// заряд 300 пК на каждом фронте. Ожидаемая ступень: 84 кода при G = 10,
// 422 кода при G = 50.
// НОМИНАЛЫ ЦЕПИ ИНЖЕКЦИИ — ИЗ ТЕКУЩЕЙ РЕДАКЦИИ §6.5, А НЕ ИЗ ПРОШЛОЙ.
// Прошивка эти номиналы человеку НАЗЫВАЕТ (он по ним паяет), и прежняя
// версия называла их все три неверно: «Rc1 10к, Rc2 1к, Ccal 1 нФ». §6.5
// сознательно уменьшил Ccal в десять раз и компенсировал напряжением:
//   sq_pin --[Rc1 1 кОм]--+--[Ccal 100 пФ]--> входной узел (туда же, куда R1)
//                         +--[Rc2 10 кОм]--> GND
//   амплитуда на делителе 3.3 В * 10к/11к = 3.0 В, заряд 100 пФ * 3.0 В = 300 пК
// Заряд, а значит и ожидаемые ступени 84/422, те же — менялась ёмкость, не
// заряд. Причина: 1 нФ на входном узле более чем удваивает Cвх (700 ->
// 1700 пФ), полюс R1*Cвх уезжает с 227 на 94 Гц, постоянная стекания
// статики Rsh*Cвх растёт с 70 до 170 мс, и расчёты §1.4 и §2.2 перестают
// соответствовать плате. С 100 пФ: Cвх = 800 пФ, полюс 199 Гц, стекание
// 80 мс — всё вне полосы. Плюс через Ccal ЛЮБАЯ активность на этом выводе
// инжектируется в суммирующий узел как заряд, неотличимый от сигнала
// плёнки; в десять раз меньшая ёмкость ослабляет и этот путь в десять раз.
// Rc2 на GND нужен именно как 10 кОм: он держит узел CAL у нуля и в
// состоянии сброса и бутлоадера, когда вывод ещё не сконфигурирован.
// Спад ступени: действуют ОБА ФВЧ, а не только 4.7 с.
// exp(-2.5/4.7) * exp(-2.5/10.1) = 0.59 * 0.78 = 0.46, то есть к концу
// полупериода 2.5 с от пика остаётся 46 %. Мерить надо ПИК СРАЗУ ПОСЛЕ
// ФРОНТА: на самом фронте ни одна из постоянных подействовать не успевает.
// Совпадение с расчётом в
// пределах ±20 % замыкает весь расчёт раздела 2 измерением.
// Фронт выдаётся из loop(), то есть с точностью около миллисекунды. Для
// 0.2 Гц и спада 4.7 с это безразлично, но индекс каждого фронта всё равно
// печатается: иначе ступень пришлось бы искать глазами.

static void sq_set(bool on) {
  g_sq_on = on;
  if (!on) {
    g_sq_level = false;
    digitalWrite(UTRO_SQ_PIN, LOW);
    push_line("# sq off\n");
    return;
  }
  g_sq_level = false;
  digitalWrite(UTRO_SQ_PIN, LOW);
  g_sq_next_ms = millis() + UTRO_SQ_HALF_MS;
  // 192 байта на форматируемую часть, схема цепи — отдельной статической
  // строкой: вместе они не влезали в буфер, и компилятор ловил это как
  // -Wformat-truncation. Обрезка здесь означала бы, что человек паяет цепь
  // инжекции по оборванному описанию.
  char buf[192];
  snprintf(buf, sizeof buf,
           "# sq on pin=%d half_ms=%lu f_mhz=200 (0.2 Гц)\n",
           (int)UTRO_SQ_PIN, (unsigned long)UTRO_SQ_HALF_MS);
  push_line(buf);
  push_line("# sq цепь теста Б §6.5: Rc1 1 кОм ОТ ЭТОГО ВЫВОДА -> узел CAL; Rc2 10 кОм с узла CAL на GND; Ccal 100 пФ с узла CAL во входной узел (туда же, куда R1). НЕ 1 нФ: §6.5 уменьшил ёмкость в 10 раз и компенсировал напряжением\n");
  push_line("# sq ожидание: заряд 300 пК на фронте, ступень 84 кода при G=10 и 422 при G=50; мерить ПИК СРАЗУ ПОСЛЕ ФРОНТА, к концу полупериода 2.5 с остаётся 46 % (обе постоянные, 4.7 и 10.1 с); совпадение +-20 % замыкает расчёт раздела 2\n");
#if UTRO_SQ_PIN != 21
  push_line("# sq ВНИМАНИЕ: в §6.5 нарисован GPIO21, но на этой плате он занят светодиодом. Паяйте Rc1 на вывод из поля pin=\n");
#endif
}

static void sq_task(uint32_t now_ms) {
  if (!g_sq_on) return;
  if ((int32_t)(now_ms - g_sq_next_ms) < 0) return;
  g_sq_next_ms = now_ms + UTRO_SQ_HALF_MS;
  g_sq_level = !g_sq_level;
  digitalWrite(UTRO_SQ_PIN, g_sq_level ? HIGH : LOW);
  char buf[96];
  snprintf(buf, sizeof buf, "# sq edge n=%lu level=%d\n",
           (unsigned long)(g_anchored ? g_n_out : 0u), g_sq_level ? 1 : 0);
  push_line(buf);
}

// --------------------------------------------------------------------------
// СЕАНС
// --------------------------------------------------------------------------

static void session_start(uint8_t mode) {
  if (!g_adc_ok) {
    push_line("# err драйвер АЦП не поднялся\n");
    return;
  }
  if (g_mode != MODE_IDLE) session_stop(true);
  g_mode = mode;
  g_settled = false;
  g_anchored = false;
  g_n_out = 0;
  g_t0_us = 0;
  g_sum = 0;
  g_ring_pos = 0;
  g_ring_fill = 0;
  g_phase = 0;

  // Счётчики потерь — СЕАНСНЫЕ. Накопительные счётчики от включения платы
  // делали строку '# end lost=450' неразборчивой (чей это сеанс?) и
  // заставляли светодиод мигать «были потери» до перезагрузки, после чего
  // аварийный сигнал перестаёт нести информацию. Итоговые суммы сохраняются
  // отдельно и печатаются полями tot_*.
  g_tot_lost += session_lost_total();
  g_tot_ovf  += g_ovf_events;
  g_lost_pool = 0;
  g_lost_tx = 0;
  g_lost_bad = 0;
  g_lost_warm = 0;
  g_align_err = 0;
  g_ovf_events = 0;
  g_drop_conv = 0;
  g_skew = 0;
  g_lost_line = 0;
  g_ovf_pre = 0;
  meas_reset();

  uint32_t now = millis();
  g_settle_until_ms = now + UTRO_SETTLE_MS;
  g_settle_tick_ms = now + UTRO_SETTLE_TICK_MS;
  g_stream_begin_ms = now;
  g_next_stat_ms = g_settle_until_ms + UTRO_STAT_MS;

  char buf[320];
  snprintf(buf, sizeof buf, "# settle ms=%lu\n", (unsigned long)UTRO_SETTLE_MS);
  push_line(buf);
  push_line("# settle почему: по АНАЛОГОВЫЙ-ТРАКТ.md §2.4 доминирующая постоянная времени тракта tau2=(R4+R4')*C4'=10.1 с, до 1 % нужно 4.6*tau2=46 с. Раньше этого на выходе монотонный дрейф во весь размах прямо в полосе дыхания 0.08-0.7 Гц, и dsp.py примет его за дыхание\n");
  push_line("# settle если плёнку только что подключили или задели - по §2.4 нужно 90 с с момента касания, а не 46: уберите руки, подождите и дайте команду заново\n");

  if (!adc_start()) {
    g_mode = MODE_IDLE;
    push_line("# err не удалось запустить АЦП\n");
  }
}

static void session_stop(bool quiet) {
  if (g_mode == MODE_STREAM || g_mode == MODE_CAL || g_mode == MODE_RAW) {
    char buf[480];        // см. push_stat про размер
    char fs[24], span[24];
    double fs_hz = 0.0, span_s = 0.0;
    if (meas_fs(&fs_hz, &span_s)) {
      fmt_fixed(fs, sizeof fs,
                (g_mode == MODE_RAW) ? fs_hz : fs_hz / (double)UTRO_DECIM, 3);
    } else {
      snprintf(fs, sizeof fs, "nan");
    }
    fmt_fixed(span, sizeof span, span_s, 1);
    snprintf(buf, sizeof buf,
             "# end mode=%s n=%lu t_ms=%lu fs_meas=%s fs_span_s=%s lost=%lu "
             "lost_pool=%lu lost_tx=%lu lost_bad=%lu lost_warm=%lu ovf=%lu "
             "align=%lu skew=%lu ovf_pre=%lu lost_line=%lu tot_lost=%lu tot_ovf=%lu\n",
             mode_name(g_mode),
             (unsigned long)g_n_out,
             (unsigned long)(millis() - g_stream_begin_ms),
             fs, span,
             (unsigned long)session_lost_total(),
             (unsigned long)g_lost_pool, (unsigned long)g_lost_tx,
             (unsigned long)g_lost_bad, (unsigned long)g_lost_warm,
             (unsigned long)g_ovf_events, (unsigned long)g_align_err,
             (unsigned long)g_skew, (unsigned long)g_ovf_pre,
             (unsigned long)g_lost_line,
             (unsigned long)(g_tot_lost + session_lost_total()),
             (unsigned long)(g_tot_ovf + g_ovf_events));
    push_line(buf);
    if (g_mode == MODE_STREAM && !g_anchored) {
      push_line("# end поток остановлен до конца установления: данных нет вовсе\n");
    }
  } else if (g_mode == MODE_IDLE && !quiet) {
    push_line("# err поток не запущен\n");
  }
  // Буфер сырого захвата освобождается и при прерванной ВЫГРУЗКЕ, а не
  // только при прерванном захвате. Прежняя версия проверяла один MODE_RAW, и
  // 'x' (или любая команда, начинающая новый сеанс) посреди выгрузки
  // оставляла 80 кБ кучи занятыми до следующей 'r': на S3 это не падение, но
  // следующий 'r 30' мог не найти памяти и молча укоротить захват — то есть
  // проверка 50 Гц делалась бы по куску короче заказанного.
  if (g_mode == MODE_RAW || g_mode == MODE_DUMP) {
    if (g_raw_buf != NULL) { free(g_raw_buf); g_raw_buf = NULL; g_raw_cap = 0; }
    // Во время выгрузки кольцо передачи забито строками данных по самое
    // горлышко (raw_dump_step льёт в него, пока есть место), поэтому
    // объяснение в него просто не влезало и уходило в lost_line: человек
    // видел обрыв выгрузки без единого слова о том, что произошло. Новых
    // строк выгрузки больше не будет - режим уже меняется, - так что
    // освобождаем место одним выталкиванием. Выбрасывать кольцо нельзя:
    // tx_flush мог отдать порту половину строки, и обрубок дал бы хосту
    // битое число - ровно то, от чего это кольцо и заведено.
    tx_flush();
    push_line(g_mode == MODE_DUMP
              ? "# raw выгрузка прервана, остаток захвата отброшен\n"
              : "# raw прервано, захваченное отброшено\n");
  }
  adc_stop();
  g_mode = MODE_IDLE;
  g_settled = false;
  g_anchored = false;
  g_sum = 0;
  g_ring_pos = 0;
  g_ring_fill = 0;
  g_phase = 0;
}

// --------------------------------------------------------------------------
// КОМАНДЫ
// --------------------------------------------------------------------------

static uint32_t parse_uint(const char *&p, bool &have) {
  uint32_t v = 0;
  have = false;
  while (*p == ' ' || *p == '\t' || *p == '=') p++;
  while (*p >= '0' && *p <= '9') {
    v = v * 10u + (uint32_t)(*p - '0');
    if (v > 100000u) v = 100000u;   // защита от длинного мусора
    p++;
    have = true;
  }
  return v;
}

static void exec_command(const char *line) {
  // Пропускаем ведущие пробелы.
  while (*line == ' ' || *line == '\t') line++;
  char op = *line;
  if (op == 0) return;
  const char *arg = line + 1;

  switch (op) {
    case 's':
      session_start(MODE_STREAM);
      if (g_mode == MODE_STREAM) push_header();
      break;

    case 'x':
      session_stop(false);
      break;

    case 'c': {
      bool have = false;
      uint32_t sec = parse_uint(arg, have);
      if (!have) sec = UTRO_CAL_DEF_S;
      session_start(MODE_CAL);
      if (g_mode == MODE_CAL) cal_begin(sec);
      break;
    }

    case 'r': {
      bool have = false;
      uint32_t sec = parse_uint(arg, have);
      if (!have) sec = UTRO_RAW_DEF_S;
      session_start(MODE_RAW);
      if (g_mode == MODE_RAW) raw_begin(sec);
      break;
    }

    case 'q':
      sq_set(!g_sq_on);
      break;

    case 'b':
      // Тест Б одной командой: меандр плюс поток, чтобы ступень попала в
      // запись и её можно было сверить с расчётом §6.5.
      if (!g_sq_on) sq_set(true);
      session_start(MODE_STREAM);
      if (g_mode == MODE_STREAM) push_header();
      push_line("# тест Б: пишите не меньше 60 с, потом 'x' и 'q'. Ступень на каждом фронте меандра: 84 кода при G=10, 422 при G=50; мерить пик сразу после фронта, к концу полупериода 2.5 с остаётся 46 % (обе постоянные, 4.7 и 10.1 с). Совпадение +-20 % замыкает расчёт раздела 2 измерением (§6.5)\n");
      break;

    case 'v':
      push_header();
      break;

    case 'z':
      g_tot_lost += session_lost_total();
      g_tot_ovf  += g_ovf_events;
      g_lost_pool = 0;
      g_lost_tx = 0;
      g_lost_bad = 0;
      g_lost_warm = 0;
      g_align_err = 0;
      g_ovf_events = 0;
      g_drop_conv = 0;
      g_skew = 0;
      g_lost_line = 0;
      g_ovf_pre = 0;
      push_line("# счётчики сеанса сброшены (итоговые tot_* сохранены)\n");
      break;

    case '?':
    case 'h':
      push_header();
      push_help();
      break;

    default: {
      char buf[64];
      snprintf(buf, sizeof buf, "# err неизвестная команда '%c'\n", op);
      push_line(buf);
      break;
    }
  }
}

static void poll_commands(void) {
  while (Serial.available() > 0) {
    int ch = Serial.read();
    if (ch < 0) break;
    if (ch == '\n' || ch == '\r') {
      if (g_cmd_len > 0) {
        g_cmd[g_cmd_len] = 0;
        exec_command(g_cmd);
        g_cmd_len = 0;
      }
      continue;
    }
    if (g_cmd_len + 1 < sizeof(g_cmd)) {
      g_cmd[g_cmd_len++] = (char)ch;
    }
    // Переполнение строки команды игнорируем: лишние символы отбрасываются,
    // команда разберётся по первому символу.
  }
}

// --------------------------------------------------------------------------
// ИНДИКАЦИЯ
// --------------------------------------------------------------------------
// Рисунок мигания, а не только цвет: на DevKitC-1 светодиод адресный и
// цветной, на XIAO — обычный одноцветный, и рисунок читается на обоих.
//   короткая вспышка раз в 2 с   — ждём команду, прошлый сеанс был чистым
//   ДВЕ коротких вспышки раз в 2 с — ждём команду, но прошлый сеанс потерял
//                                  отсчёты: его результату верить нельзя
//   мигает 1 Гц                  — идёт установление тракта (46 с)
//   горит ровно                  — идёт запись, потерь нет
//   мигает 2 Гц                  — идёт запись, но отсчёты терялись
//   мигает 5 Гц                  — калибровка или сырой захват, потерь нет
//   частые двойные вспышки       — калибровка/захват С ПОТЕРЯМИ
// Двойные вспышки заведены потому, что прежняя версия в режиме калибровки
// мигала одинаково при потерях и без них: человек у матраса смотрит на
// плату, а не в терминал, и испорченную калибровку должен видеть сразу.
// По той же причине отказ переживает КОНЕЦ сеанса: иначе провалившаяся
// калибровка сообщала о себе светодиодом ровно до своей последней строки, а
// человек подходит к плате уже после.
// Счётчики потерь здесь СЕАНСНЫЕ: накопительные заставляли мигать «были
// потери» до перезагрузки и приучали оператора игнорировать аварийный
// сигнал.

static void led_write(bool on) {
  if (on == g_led_on) return;
  g_led_on = on;
#if UTRO_LED_RGB
  // Адресный светодиод: pinMode для него не нужен и вреден (см. конфигурацию).
  // Яркость низкая: плата стоит у кровати.
  if (!on) {
    neopixelWrite(RGB_BUILTIN, 0, 0, 0);
  } else if (g_mode == MODE_STREAM) {
    neopixelWrite(RGB_BUILTIN, session_losses() ? 12 : 0, session_losses() ? 0 : 12, 0);
  } else if (g_mode == MODE_CAL || g_mode == MODE_RAW || g_mode == MODE_DUMP) {
    neopixelWrite(RGB_BUILTIN, session_losses() ? 12 : 0, 0, 12);
  } else {
    // Ожидание команды: жёлтый. Красный, если прошлый сеанс терял отсчёты —
    // на цветной плате это читается ещё раньше, чем рисунок мигания.
    if (session_losses()) neopixelWrite(RGB_BUILTIN, 12, 0, 0);
    else                  neopixelWrite(RGB_BUILTIN, 6, 6, 0);
  }
#else
#if UTRO_LED_ACTIVE_LOW
  digitalWrite(UTRO_LED_PIN, on ? LOW : HIGH);
#else
  digitalWrite(UTRO_LED_PIN, on ? HIGH : LOW);
#endif
#endif
}

static void led_task(uint32_t now_ms) {
  if ((int32_t)(now_ms - g_led_next_ms) < 0) return;
  bool losses = session_losses();

  if (g_mode != MODE_IDLE && !g_settled) {
    led_write(!g_led_on);
    g_led_next_ms = now_ms + 500;             // 1 Гц: установление
    return;
  }
  if (g_mode == MODE_CAL || g_mode == MODE_RAW || g_mode == MODE_DUMP) {
    if (!losses) {
      led_write(!g_led_on);
      g_led_next_ms = now_ms + 100;           // 5 Гц
    } else {
      // Двойная вспышка: вкл-выкл-вкл-пауза.
      switch (g_led_step & 3u) {
        case 0: led_write(true);  g_led_next_ms = now_ms + 60;  break;
        case 1: led_write(false); g_led_next_ms = now_ms + 120; break;
        case 2: led_write(true);  g_led_next_ms = now_ms + 60;  break;
        default: led_write(false); g_led_next_ms = now_ms + 760; break;
      }
      g_led_step++;
    }
    return;
  }
  if (g_mode == MODE_STREAM) {
    if (!losses) {
      led_write(true);
      g_led_next_ms = now_ms + 200;
    } else {
      led_write(!g_led_on);
      g_led_next_ms = now_ms + 250;           // 2 Гц
    }
    return;
  }
  // Ожидание команды. Если ПРЕДЫДУЩИЙ сеанс кончился с потерями — двойная
  // вспышка вместо одиночной, и держится она до следующей команды.
  // Иначе индикация отказа живёт ровно до строки отчёта: человек уложил
  // плёнку, дал 'c 30', отошёл к матрасу и смотрит на плату (именно этот
  // сценарий описан выше), калибровка провалилась, режим стал IDLE — и плата
  // тут же начинала мигать «жду команду», то есть ровно как после удачной
  // калибровки. Счётчики сеанса обнуляются в session_start, а не в
  // session_stop, поэтому после сеанса они ещё держат его итог, и спрашивать
  // их здесь корректно; после перезагрузки они нулевые, так что чистая плата
  // мигает одиночно.
  if (losses) {
    switch (g_led_step & 3u) {
      case 0: led_write(true);  g_led_next_ms = now_ms + 40;   break;
      case 1: led_write(false); g_led_next_ms = now_ms + 160;  break;
      case 2: led_write(true);  g_led_next_ms = now_ms + 40;   break;
      default: led_write(false); g_led_next_ms = now_ms + 1760; break;
    }
    g_led_step++;
    return;
  }
  if (g_led_on) {
    led_write(false);
    g_led_next_ms = now_ms + 1960;
  } else {
    led_write(true);
    g_led_next_ms = now_ms + 40;
  }
}

// --------------------------------------------------------------------------
// ТОЧКИ ВХОДА
// --------------------------------------------------------------------------

void setup() {
#if !UTRO_LED_RGB
  pinMode(UTRO_LED_PIN, OUTPUT);
#endif
  g_led_on = true;          // чтобы led_write гарантированно записал погашенное
  led_write(false);

  pinMode(UTRO_SQ_PIN, OUTPUT);
  digitalWrite(UTRO_SQ_PIN, LOW);

  Serial.begin(UTRO_SERIAL_BAUD);
  // Намеренно не ждём подключения хоста: прошивка должна подниматься и без
  // него. Поэтому стартовый заголовок может потеряться — он повторяется на
  // каждую команду 's' и по команде 'v', и хост обязан опираться на это, а
  // не на баннер при включении. Если строка заголовка не поместилась в
  // кольцо передачи, это видно в поле lost_line.
  // ОТДЕЛЬНО: лог ядра ESP-IDF по умолчанию идёт в тот же порт. Любая его
  // строка, вклинившаяся в поток, даст хосту битое число. Поэтому в сборке
  // стенда уровень лога ядра обязан быть «None» (Tools -> Core Debug Level),
  // и ни один вызов здесь не должен печатать ошибку ядра — в частности
  // pinMode не вызывается для адресного светодиода.

  g_adc_ok = adc_setup();

#if UTRO_HAVE_CALI
  {
    adc_cali_curve_fitting_config_t cc = {};
    cc.unit_id  = ADC_UNIT_1;
    cc.atten    = UTRO_ADC_ATTEN;
    cc.bitwidth = UTRO_ADC_BITS;
    // Поле chan в этой структуре появилось не во всех версиях IDF и на S3
    // на результат не влияет: калибровочные коэффициенты в eFuse хранятся
    // по ослаблению, а не по каналу. Оставляем нулевым.
    if (adc_cali_create_scheme_curve_fitting(&cc, &g_cali) != ESP_OK) {
      g_cali = NULL;
    }
  }
#endif

  push_header();
  push_help();
}

void loop() {
  uint32_t now_ms = millis();

  // Порядок важен: сначала освобождаем место в буфере передачи, потом
  // вычерпываем пул. Наоборот — и порог UTRO_TX_LOW_WATER будет срабатывать
  // на полном буфере, которого уже нет.
  tx_flush();

  bool worked = pump_adc();

  // Завершение режимов проверяется здесь, а не внутри разбора чтения: смена
  // режима посреди цикла по прочитанным байтам отдала бы остаток кадра не в
  // тот обработчик.
  if (g_mode == MODE_CAL && g_anchored && g_n_out >= g_cal_target) {
    cal_report();
  } else if (g_mode == MODE_RAW && g_raw_buf != NULL && g_raw_len >= g_raw_cap) {
    raw_finish();
  }

  if (g_mode == MODE_DUMP) {
    uint32_t before = g_dump_i;
    raw_dump_step();
    if (g_dump_i != before) worked = true;
    if (g_mode == MODE_DUMP && (int32_t)(now_ms - g_dump_next_ms) >= 0) {
      g_dump_next_ms = now_ms + UTRO_STAT_MS;
      char buf[96];
      snprintf(buf, sizeof buf, "# dump i=%lu of %lu\n",
               (unsigned long)g_dump_i, (unsigned long)g_raw_len);
      push_line(buf);
    }
  }

  // Статистика идёт во всех активных режимах: потеря, невидимая в
  // калибровке или в сыром захвате, обесценивает проверку, ради которой
  // режим и существует.
  if ((g_mode == MODE_STREAM || g_mode == MODE_CAL || g_mode == MODE_RAW)
      && g_anchored && (int32_t)(now_ms - g_next_stat_ms) >= 0) {
    push_stat();
    g_next_stat_ms = now_ms + UTRO_STAT_MS;
  }

  poll_commands();
  sq_task(now_ms);
  led_task(now_ms);

  // Если работы не было — отдаём такт системе. Без этого задача loop()
  // крутится вплотную и сторожевой таймер простаивающей задачи может
  // сработать. Миллисекунда безопасна: кадр приходит раз в 5 мс, а пул
  // держит секунду.
  if (!worked) delay(1);
}
