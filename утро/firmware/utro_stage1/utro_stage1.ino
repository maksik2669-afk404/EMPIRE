#endif
           "\n",
           UTRO_FW_VERSION, UTRO_PROTO,
           (unsigned long)UTRO_OUT_RATE_HZ,
           (unsigned long)UTRO_SUM_LEN,
           (unsigned long)UTRO_SUM_LEN,
           (unsigned long)UTRO_DECIM,
           (unsigned long)UTRO_RAW_RATE_HZ,
           (unsigned long)UTRO_MAINS_HZ,
           kAdcBits,
           (unsigned long)UTRO_SUM_LEN,
           (unsigned long)UTRO_VALUE_MAX,
           (int)UTRO_ADC_GPIO, (int)UTRO_ADC_CHANNEL,
           atten_db_str(),
           (unsigned long)UTRO_SETTLE_MS,
           (int)UTRO_SQ_PIN,
           UTRO_TRANSPORT_CDC ? "usb_cdc" : "uart0"
