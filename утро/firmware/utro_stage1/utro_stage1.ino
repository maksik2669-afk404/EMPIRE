// utro_stage1.ino — прошивка проверочного стенда «Утро», ЭТАП 1.
//
// Платформа: ESP32-S3, Arduino-ESP32 core 3.x (ESP-IDF 5.1+).
//
// ЗАЧЕМ ЭТО СУЩЕСТВУЕТ
// Этап 1 отвечает на один вопрос: пробивается ли пульс через конкретный
// матрас. Прошивка не считает дыхание и не считает пульс. Её работа —
// отдать хосту сигнал плёнки на частоте 200 Гц, СКАЗАТЬ, какая эта частота
// на самом деле, и честно признаться, если хоть один отсчёт потерян.
// Всё остальное делает утро/morning/dsp.py (функция analyze_window).
//
// Если прошивка соврёт о частоте дискретизации, dsp.py выдаст неверное
// число вдохов и ударов, и человек этого не заметит: 15.3 вдоха в минуту
// выглядит так же правдоподобно, как 15.0. Поэтому вся конструкция ниже
// подчинена одному: ось времени должна быть правдой, а где она может
// соврать — прошивка обязана сама это измерить и напечатать.
//
// СХЕМА ОЦИФРОВКИ — ЕДИНАЯ С АНАЛОГОВЫМ ТРАКТОМ (firmware/АНАЛОГОВЫЙ-ТРАКТ.md §4.3)
//   сырая частота АЦП      4000 Гц (непрерывный режим, DMA)
//   окно суммирования      80 сырых отсчётов = 20.000 мс = один период 50 Гц
//   суммирование           СКОЛЬЗЯЩЕЕ (кольцо на 80, бегущая сумма)
//   выдача результата      каждые 20 сырых отсчётов -> ровно 200 Гц
// Это не стилистический выбор, а два обязательства документа:
//  1) Скользящая сумма ровно по одному периоду сети — гребёнчатый фильтр с
//     ТОЧНЫМ нулём на 50/100/150 Гц. Именно на нём держится вывод §4.2
//     «аналоговый режектор не нужен» (−40 дБ и глубже вместо −0.9 дБ,
//     которые даёт блочное усреднение по 32 на 6400 Гц).
//  2) Антиалиасинг §4.4: составляющая 46 Гц сворачивается при прореживании
//     dsp.py до 50 Гц точно в 4 Гц — нижний край кардиополосы. Гребёнка по
//     80 даёт на 46 Гц 0.086 (−21.3 дБ), блочная по 32 — 0.915 (−0.8 дБ).
//     Разница в 20 дБ попадает прямо в полосу пульса.
// ТРЕТЬЕГО ОБЯЗАТЕЛЬСТВА — «шум падает в sqrt(80) раз» — НЕ СУЩЕСТВУЕТ, и
// прежняя редакция этой шапки его выдумывала. Она писала: «2 LSB/sqrt(80) =
// 0.224 LSB, в полосе пульса 0.089 LSB, отсюда допустимое отношение
// дыхание:пульс 1770:1». Оба числа §2.3 называет своей главной
// арифметической ошибкой и исправляет:
//   в sqrt(80) падает ПОЛНЫЙ СКО, а полоса пульса 4–20 Гц лежит почти
//   целиком ВНУТРИ полосы самого фильтра (эквивалентная шумовая полоса
//   fs_raw/(2N) = 25 Гц, спад −3 дБ около 22 Гц), поэтому в полосе пульса
//   выигрыш 11 %, а не 8.94 раза: 0.179 -> 0.161 LSB = 0.122 мВ;
//   допустимое отношение дыхание:пульс — 575:1 (700 мВ бюджетного дыхания
//   на порог различимости 10*0.122 мВ), а не 1770:1, где запас считался
//   дважды из взаимно исключающих предпосылок.
// Запас 575:1 при ожидаемых 10–40:1 остаётся избыточным, так что вывод
// «дыхание не задавит пульс» в силе — но держится он на разрядности АЦП и
// выборе G, а не на усреднении. Сумма по 80 нужна за нуль на 50 Гц и
// антиалиасинг; за это она платит −2.4 дБ на 20 Гц и −0.5 дБ на 9 Гц.
// Полный СКО всё же падает ровно в sqrt(80), и именно это проверяет поле
// noise_gain в отчёте калибровки — см. комментарий к cal_report.
// И отдельно — точность частоты. У adc_continuous частоту задаёт ЦЕЛОЕ число
// тактов: interval = f_clk/16/2/fs_raw. При 4000 Гц это 80e6/32/4000 = 625 и
// 160e6/32/4000 = 1250 — целые при ОБЕИХ раскладках тактов, то есть какой бы
// источник ни выбрал драйвер, частота остаётся кварцевой. Для 6400 Гц оба
// делителя нецелые (390.625 и 781.25), и частота уезжает на +0.16 % или
// +0.03 % в зависимости от версии ядра. Поэтому 4000, а не 6400.
//
// ВЫХОДНЫЕ ОТСЧЁТЫ ПЕРЕКРЫВАЮТСЯ. Окно 80, шаг 20: соседние отсчёты делят
// 60 сырых значений из 80. Для dsp.py это безразлично (линейный фильтр плюс
// прореживание — ровно то, что задумано), но тот, кто считает шум ПО
// СОСЕДНИМ отсчётам, обязан знать, что они коррелированы.
//
// ФИЗИКА, КОТОРУЮ ПРОШИВКА НЕ МОЖЕТ ИСПРАВИТЬ
// PVDF — источник ЗАРЯДА, не напряжения. Ёмкость LDT0-028K около 500 пФ,
// выход высокоимпедансный. Между плёнкой и этим кодом ОБЯЗАН стоять
// зарядовый усилитель (см. АНАЛОГОВЫЙ-ТРАКТ.md §1.4), иначе на входе АЦП не
// будет ничего, кроме наводки сети.
// Амплитуда дыхания на порядок больше сердечной. Если аналоговое усиление
// выставлено так, что дыхание занимает весь диапазон АЦП, пульс утонет в
// одном младшем разряде. Проверять это — командой калибровки, с человеком на
// матрасе: по §6.6 целевой размах 1850 кодов, приемлемо 1200…2400, рабочий
// предел ±1200 мВ = 3170 кодов (§2.3). Пороги в отчёте калибровки взяты
// ровно из этих чисел, а не придуманы здесь.
//
// ПРОТОКОЛ (USB-Serial, текст)
//   Строки, начинающиеся с '#', — служебные, хост их пропускает.
//   Строки данных: "<индекс>,<значение>\n", оба числа десятичные без знака.
//   индекс    — НЕ счётчик принятых отсчётов, а ВРЕМЕННАЯ КООРДИНАТА:
//               в режиме потока индекс k означает момент t0 + k/fs,
//               fs = 200 Гц номинально и fs_meas фактически (см. ниже).
//               Разрыв в индексах равен числу потерянных отсчётов. Хост
//               обязан либо вставить пропуски, либо отбросить окно с
//               разрывом.
//   значение  — СУММА 80 отсчётов АЦП, 0..327600. Не среднее: деление
//               выбросило бы те самые 3.1 разряда, которые дало суммирование.
//               Для вольт делить на 80. Для dsp.py делить не нужно, он
//               инвариантен к масштабу.
//   В режиме сырого потока ось индексов — сырые отсчёты (1/4000 с), а
//   значение — один отсчёт АЦП, 0..4095. Что именно едет по проводу, сказано
//   в строке "# begin mode=..." и в "# raw begin".
//
// ИЗМЕРЕННАЯ ЧАСТОТА — ОБЯЗАТЕЛЬНОЕ ПОЛЕ, А НЕ УКРАШЕНИЕ
//   Строки "# stat" и "# end" несут fs_meas=<Гц> и fs_span_s=<с>: частота,
//   посчитанная по числу фактически оцифрованных отсчётов и системному
//   таймеру, и длина интервала, по которому она посчитана. ХОСТ ОБЯЗАН
//   передавать в analyze_window ЭТУ частоту, а не номинальные 200.0.
//   fs_meas измеряется только на интервалах БЕЗ потерь (потеря искажает
//   счёт), поэтому fs_span_s может быть меньше длины записи — и это видно.
//   Пока fs_span_s < 2 с, печатается fs_meas=nan: короткий интервал даёт
//   неверное число, а неверное число хуже отсутствующего.
//
// ОБЯЗАННОСТИ ХОСТА, БЕЗ КОТОРЫХ ПУЛЬС НЕ НАЙДЁТСЯ ИЛИ НАЙДЁТСЯ ЛОЖНЫЙ
// 1. Перед вызовом analyze_window из каждого окна НАДО ВЫЧЕСТЬ ЕГО ПЕРВЫЙ
//    ОТСЧЁТ:  w = [x - window[0] for x in window].
//    Это не косметика. Выход зарядового усилителя сидит на середине питания,
//    поэтому в потоке всегда есть большое положительное смещение (около
//    2048*80 = 163840). Биквады в dsp.py стартуют с нулевым состоянием, и
//    это смещение для них — ступенька во весь диапазон. Переходный процесс
//    от неё попадает в кардиополосу, детектор шевеления видит выброс
//    энергии, ставит motion=True, и пульс не выдаётся вовсе. Проверено на
//    синтетике (morning/synth.py, 23 положения окна по 60 с, дыхание 15,
//    пульс 63):
//      без вычитания         — пульс найден в  3 окнах из 23
//      вычтено среднее окна  — в 11 из 23
//      вычтен первый отсчёт  — в 23 из 23
// 2. ПРОВЕРИТЬ КРАТНОСТЬ ПУЛЬСА ДЫХАНИЮ. Огибающая кардиополосы по
//    построению модулируется дыханием, поэтому в её спектре всегда есть
//    линии на кратных частоте дыхания: при дыхании 15/мин это 45, 60, 75,
//    90, 105 и 120 уд/мин — шесть правдоподобных «пульсов». Эта проверка
//    делается НЕ здесь (прошивка не считает ни дыхание, ни пульс), но
//    прошивка обязана отдать для неё всё нужное, и отдаёт: один непрерывный
//    поток с честной осью времени, измеренную fs (сдвиг fs двигает и
//    hr_bpm, и resp_bpm, и кратность перестала бы сходиться) и видимые
//    разрывы, чтобы окно с разрывом вообще не попало в счёт.
// 3. Использовать fs_meas, а не 200.0 (см. выше).
//
// Почему смещение не убирает прошивка: во-первых, уровень покоя — главная
// проверка, жив ли тракт, и терять его нельзя; во-вторых, вычитание
// скользящего среднего в прошивке — это фильтр верхних частот с
// характеристикой, попадающей прямо в полосу дыхания 0.08–0.7 Гц, то есть
// порча измеряемой величины ради удобства разбора.
//
// КОМАНДЫ (одна строка, завершается \n или \r)
//   s        начать поток 200 Гц (сумма 80)
//   x        остановить поток / калибровку / сырой захват
//   c[N]     калибровка: N секунд (3..60, по умолчанию 10), затем отчёт
//   r[N]     сырой поток 4000 Гц: захват N секунд в ОЗУ, затем выгрузка
//            (для обязательной проверки 50 Гц, АНАЛОГОВЫЙ-ТРАКТ.md §6.7)
//   q        включить/выключить калибровочный меандр 0.2 Гц (тест Б §6.5)
//   b        тест Б целиком: меандр + поток 200 Гц одной командой
//   v        повторить строку-заголовок
//   z        сбросить счётчики потерь текущего сеанса
//   ?        справка
//
// ПОРЯДОК РАБОТЫ
//   1. Собрать тракт, НЕ кладя плёнку под матрас. Подать питание.
//   2. "c 10" — проверить, что тракт жив: смещение около середины
//      диапазона, шум сырых отсчётов не нулевой, наводка 50 Гц в бюджете.
//   3. "r 10" — обязательная проверка 50 Гц по §6.7, на сыром потоке.
//      На усреднённом потоке её делать НЕЛЬЗЯ: скользящая сумма по 80 имеет
//      на 50 Гц точный нуль и покажет отсутствие наводки даже тогда, когда
//      наводка велика.
//   4. "b" — тест Б §6.5: инжекция известного заряда, сверить ступень с
//      расчётом (G=10: 84 кода, G=50: 422 кода).
//   5. Уложить плёнку под матрас на уровне груди, лечь.
//   6. "c 30" — убедиться, что дыхание не упирает тракт в шину и размах в
//      пределах §6.6.
//   7. "s", писать 10 минут, "x". analyze_window требует минимум 20 с
//      (4000 отсчётов), рабочее окно продукта — 60 с.
// Перед каждым сеансом прошивка ждёт установления тракта 46 с и говорит,
// сколько ждёт и почему (см. UTRO_SETTLE_MS).
//
// ЧТО НЕ ПРОВЕРЕНО НА ЖЕЛЕЗЕ
// Ни одна строка этого файла не работала с реальной плёнкой. Все пороги в
// отчёте калибровки взяты из расчётов АНАЛОГОВЫЙ-ТРАКТ.md, а сами расчёты по
// признанию того же документа не замкнуты измерением (его §8). Числа,
// которые надо мерить осциллографом на собранном усилителе, помечены по
// месту словом ИЗМЕРИТЬ. Шум сырого отсчёта 2 LSB RMS, из которого §2.3
// выводит и шум в полосе пульса 0.161 LSB, и допустимое отношение
// дыхание:пульс 575:1, — тоже оценка, а не измерение. Отчёт калибровки
// печатает и сам сырой СКО (поле sd строки '# cal raw'), и отношение
// sd_raw/sd_out, то есть позволяет проверить и величину шума, и его белизну.
// Сборка проверена компилятором g++ с заглушками API (ESP-IDF и Arduino-ядра
// в этом окружении нет) и прогоном поддельного пула DMA; на плате не
// запускалась.

// --------------------------------------------------------------------------
// КОНФИГУРАЦИЯ
// --------------------------------------------------------------------------

#define UTRO_FW_VERSION "2.0.0"
// proto=2: значение — сумма 80 (а не 32), появились режимы сырого потока и
// меандра, в "# stat"/"# end" добавлена измеренная частота. Хост, написанный
// под proto=1, прочитает поток, но получит другой масштаб значений.
#define UTRO_PROTO      2

// Вход АЦП. ТОЛЬКО ADC1: на ESP32-S3 он выведен на GPIO1..GPIO10, и номер
// канала равен номеру вывода минус один. ADC2 (GPIO11..GPIO20) брать нельзя
// по трём причинам: он делится с радиоблоком, в режиме DMA на S3 он
// проблемен, а GPIO19/20 — это линии USB, через которые идёт сам поток.
// GPIO4 (ADC1_CH3) выбран потому, что он свободен и на DevKitC-1, и на
// XIAO ESP32-S3, не является выводом загрузочной стратегии (в отличие от
// GPIO0/3/45/46), не занят флешем и PSRAM (GPIO26..37 на N16R8) и не
// совпадает со встроенным светодиодом.
#ifndef UTRO_ADC_GPIO
#define UTRO_ADC_GPIO 4
#endif

// 12 дБ — максимальное ослабление, диапазон примерно 0..3.1 В. Нужен весь
// диапазон: выход зарядового усилителя сидит на середине питания (~1.65 В),
// и сигнал идёт в обе стороны от неё.
#define UTRO_ADC_ATTEN  ADC_ATTEN_DB_12

// На S3 у АЦП только 12 разрядов, выбора нет.
#define UTRO_ADC_BITS   ADC_BITWIDTH_12
#define UTRO_ADC_MAX    4095u

// Итоговая частота. Ровно та, которую ждёт dsp.py по умолчанию.
#define UTRO_OUT_RATE_HZ   200u

// Частота сети, под период которой подобрано окно суммирования. Для 60 Гц
// см. предупреждение ниже: там целого делителя АЦП не существует.
#ifndef UTRO_MAINS_HZ
#define UTRO_MAINS_HZ      50u
#endif

// Длина окна скользящей суммы в СЫРЫХ отсчётах. 80 на 4000 Гц = 20.000 мс =
// один период 50 Гц. Отсюда и сырая частота: 80 * 50 = 4000 Гц.
#define UTRO_SUM_LEN       80u
#define UTRO_RAW_RATE_HZ   (UTRO_SUM_LEN * UTRO_MAINS_HZ)
// Прореживание: выдача каждые 20 сырых отсчётов -> 4000/20 = 200 Гц.
#define UTRO_DECIM         (UTRO_RAW_RATE_HZ / UTRO_OUT_RATE_HZ)
// Максимум значения в протоколе: сумма 80 отсчётов по 4095.
#define UTRO_VALUE_MAX     (UTRO_SUM_LEN * UTRO_ADC_MAX)

// Скорость порта. Строка данных в худшем случае 18 байт (10 цифр индекса,
// запятая, 6 цифр значения, перевод строки), типично 15. Поток 200 Гц:
// 200 * 15 = 3000 Б/с, на проводе с старт-стоповыми битами 30 кбит/с.
// 460800 бод даёт 46 кБ/с, запас 15-кратный, и это стандартный делитель,
// который без проблем держат CP2102N, CH343 и FTDI на платах DevKitC-1.
// Если мост старый (CH340) и на 460800 сыпятся ошибки — поставить 115200,
// запас останется четырёхкратным.
// ВАЖНО про сырой поток: 4000 Гц * 11 байт = 44 кБ/с — в провод 460800 бод
// он уже не влезает с запасом, поэтому сырой режим НЕ стримит, а пишет в
// ОЗУ и выгружает после (см. UTRO_RAW_DEF_S). На XIAO ESP32-S3 моста
// USB-UART нет вообще: там Serial — это всегда нативный USB, и число ниже к
// делу не относится (в заголовок оно в этом случае не печатается).
#define UTRO_SERIAL_BAUD   460800

// Пул DMA: 1.0 с сигнала. Это запас на случай, когда хост или USB-стек
// задумались. Цена — 16 кБ внутренней памяти, на S3 это не проблема.
#define UTRO_POOL_FRAMES   200u

// Буфер передачи: 8 кБ, около 540 строк, то есть ещё примерно 2.7 с.
// Пока он не опустеет, пул DMA не вычерпывается — так два буфера работают
// как один, и потеря возможна только в одном месте: в пуле.
#define UTRO_TX_RING       8192u
#define UTRO_TX_LOW_WATER  256u

// Время установления тракта перед записью. По АНАЛОГОВЫЙ-ТРАКТ.md §2.4:
//   tau1 = Rf*Cf = 4.7 с (каскад 1)
//   tau2 = (R4+R4')*C4' = 10.1 с (разделение по постоянному току) — она и
//   доминирует, до 1 % по ней нужно 4.6 * 10.1 = 46 с.
// Прежние 2 с были обоснованы фильтром верхних частот с углом 0.08 Гц,
// которого в тракте НЕТ. Через 2 с по доминирующей постоянной установилось
// 18 %, то есть 82 % переходного процесса ещё впереди: монотонный дрейф во
// весь размах внутри первых окон, прямо в полосе дыхания 0.08–0.7 Гц.
// Вычитание первого отсчёта убирает ступеньку, но не наклон.
// §2.4 даёт и практическое правило: после включения питания, подключения
// плёнки и любого удара по плёнке ждать 90 с. Эти 90 с прошивка обеспечить
// не может — она не знает, когда человек трогал плёнку; поэтому она ждёт
// расчётные 46 с от команды и ГОВОРИТ про 90 с в строке "# settle".
#define UTRO_SETTLE_MS     46000u
// Как часто печатать, сколько ещё ждать: без этого 46 с тишины выглядят как
// зависшая плата.
#define UTRO_SETTLE_TICK_MS 10000u

// Как часто во время сеанса отдавать строку статистики. Статистика идёт во
// ВСЕХ активных режимах: потеря, невидимая в калибровке, обесценивает
// калибровку.
#define UTRO_STAT_MS       5000u

// Калибровка: по умолчанию, минимум и максимум в секундах. Минимум 3 с, а не
// 1: оценка наводки 50 Гц считается блоками по 1 с, и первый блок всегда
// отбрасывается (в нём устанавливается оценка постоянной составляющей).
#define UTRO_CAL_DEF_S     10u
#define UTRO_CAL_MIN_S     3u
#define UTRO_CAL_MAX_S     60u

// Сырой захват: по умолчанию 10 с — ровно столько требует §6.7. Память:
// 10 с * 4000 Гц * 2 байта = 80 кБ, берётся из кучи на время захвата и
// возвращается после выгрузки.
#define UTRO_RAW_DEF_S     10u
#define UTRO_RAW_MAX_S     30u
// Сколько разрывов запоминать поимённо. Больше восьми — запись всё равно
// негодна, и общее число потерянных отсчётов печатается отдельно.
#define UTRO_RAW_GAPS      8u

// Калибровочный меандр для теста Б (§6.5): 0.2 Гц, то есть полпериода 2.5 с.
// 0.2 Гц выбрано не нами — так в документе, чтобы на каждой ступени был
// виден спад с постоянной 4.7 с.
#define UTRO_SQ_HALF_MS    2500u

// Светодиод и вывод калибровочного меандра выбираются НИЖЕ, после
// #include <Arduino.h>: макросы платы (LED_BUILTIN, RGB_BUILTIN,
// ARDUINO_XIAO_ESP32S3) приходят из pins_arduino.h, который подключается
// этим include. Если решать их здесь, ни один макрос платы ещё не виден, и
// выбор молча падает в запасной вариант — именно это и было в прошлой
// версии файла.

// Номинальный размах входа при ослаблении 12 дБ, из документации.
// Используется только когда калибровка по eFuse недоступна; ошибка до 10%.
#define UTRO_FULL_SCALE_MV 3100

// --------------------------------------------------------------------------
// ПОДКЛЮЧЕНИЯ И ПРОВЕРКИ СБОРКИ
// --------------------------------------------------------------------------

#include <Arduino.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#include "esp_adc/adc_continuous.h"
#include "esp_adc/adc_cali.h"
#include "esp_adc/adc_cali_scheme.h"
#include "esp_timer.h"
#include "soc/soc_caps.h"

// --------------------------------------------------------------------------
// СВЕТОДИОД И ВЫВОД МЕАНДРА
// --------------------------------------------------------------------------
// Светодиод на двух заявленных платах устроен по-разному, и «обычно ядро само
// определит LED_BUILTIN» — неверно:
//  - На DevKitC-1 (Arduino-ESP32 3.x) LED_BUILTIN == RGB_BUILTIN ==
//    SOC_GPIO_PIN_COUNT + 48, то есть НЕ номер вывода. digitalWrite по этому
//    числу ядро перехватывает и уводит в neopixelWrite, а pinMode — не
//    перехватывает: он не проходит GPIO_IS_VALID_GPIO и печатает ошибку в
//    лог при каждом старте. Если лог ядра направлен в тот же Serial, эта
//    строка вклинится в поток и хост получит битое число.
//    Поэтому для адресного светодиода здесь отдельная ветка: pinMode не
//    вызывается вовсе, пишем через neopixelWrite, и заодно получаем цвета.
//  - На XIAO ESP32-S3 LED_BUILTIN существует и равен GPIO21, но светодиод
//    включается НИЗКИМ уровнем. С UTRO_LED_ACTIVE_LOW = 0 вся индикация на
//    этой плате инвертирована: «ждём команду» выглядит как «идёт запись».
//    Поэтому полярность выводится из макроса платы, а не ставится руками.
// UTRO_LED_FORCE_GPIO=1 — аварийный выход, если на плате RGB_BUILTIN
// определён, а адресного светодиода нет.
#if defined(RGB_BUILTIN) && !defined(UTRO_LED_FORCE_GPIO)
#define UTRO_LED_RGB 1
#else
#define UTRO_LED_RGB 0
#endif

#if !UTRO_LED_RGB
#if !defined(UTRO_LED_PIN)
#if defined(LED_BUILTIN)
#define UTRO_LED_PIN LED_BUILTIN
#else
#define UTRO_LED_PIN 21
#endif
#endif
#if !defined(UTRO_LED_ACTIVE_LOW)
#if defined(ARDUINO_XIAO_ESP32S3) || defined(ARDUINO_XIAO_ESP32S3_PLUS)
#define UTRO_LED_ACTIVE_LOW 1
#else
#define UTRO_LED_ACTIVE_LOW 0
#endif
#endif
#endif

// Вывод калибровочного меандра. В §6.5 нарисован GPIO21 — но на XIAO это
// вывод встроенного светодиода, и прошлая версия дёргала меандром ровно тот
// пин, которым показывает состояние: индикация врала бы, а инжекция заряда
// шла бы с рисунком мигания вместо 0.2 Гц. Поэтому: 21, если он свободен, и
// другой вывод, если занят. Какой именно — печатается в заголовке и в ответе
// на 'q', потому что к нему человек паяет Rc1 (§6.5), и догадываться он не
// должен.
// GPIO9 — это ADC1_CH8: он свободен и на DevKitC-1, и на XIAO, не
// загрузочный и не занят флешем/PSRAM. То, что он относится к ADC1, роли не
// играет: сканируется только канал 3, а вывод настроен как цифровой выход.
// Соседство с аналоговым входом на плате — повод вести провод Rc1 подальше
// от входного узла; меандр 0.2 Гц сам по себе наводок в полосе 4–20 Гц не
// даёт, но фронт даёт, и он виден как ступень — то есть как сигнал теста.
#if !defined(UTRO_SQ_PIN)
#if !UTRO_LED_RGB && (UTRO_LED_PIN == 21)
#define UTRO_SQ_PIN 9
#else
#define UTRO_SQ_PIN 21
#endif
#endif


// Лучше не собраться, чем собраться и молча выдавать мусор на другой плате:
// распределение каналов АЦП и наличие драйвера adc_continuous у разных
// чипов разное.
#if !defined(CONFIG_IDF_TARGET_ESP32S3)
#error "utro_stage1 рассчитана только на ESP32-S3: распределение каналов ADC1 и режим DMA у других чипов другие. Выберите плату ESP32-S3."
#endif

#if !defined(ESP_ARDUINO_VERSION) || !defined(ESP_ARDUINO_VERSION_VAL)
#error "Нужен Arduino-ESP32 core 3.x: в версиях 2.x нет драйвера adc_continuous (esp_adc), а analogRead в loop() даёт дрожание, из-за которого оценка частоты становится ложью."
#elif ESP_ARDUINO_VERSION < ESP_ARDUINO_VERSION_VAL(3, 0, 0)
#error "Нужен Arduino-ESP32 core 3.x: в версиях 2.x нет драйвера adc_continuous (esp_adc)."
#endif

// СБОРКА. В каталоге скетча нет ни platformio.ini, ни sketch.json, поэтому
// транспорт выбирает человек в меню IDE, и от этого выбора зависит, чем
// является Serial: нативный USB (HWCDC) или UART0 через мост. Это не
// косметика: availableForWrite у HWCDC возвращает место в кольце USB-драйвера,
// у HardwareSerial без TX-буфера — место в аппаратном FIFO (128 байт), а от
// этой величины зависит, как часто срабатывает UTRO_TX_LOW_WATER и как часто
// переполняется пул. Две сборки одного файла теряют отсчёты по-разному.
// Пока файла сборки нет, прошивка хотя бы НАЗЫВАЕТ транспорт в заголовке
// (поле transport=), а эталонная сборка такая:
//   esp32:esp32:esp32s3:USBMode=hwcdc,CDCOnBoot=cdc,PSRAM=disabled,
//                        FlashSize=16M,PartitionScheme=default_16MB
// Зафиксировать её в репозитории — отдельная задача: она лежит вне этого
// файла (нужен sketch.json или platformio.ini рядом со скетчем).
#if defined(ARDUINO_USB_CDC_ON_BOOT) && ARDUINO_USB_CDC_ON_BOOT
#define UTRO_TRANSPORT_CDC 1
#else
#define UTRO_TRANSPORT_CDC 0
#endif

// ADC1 на S3: GPIO1..GPIO10 -> каналы 0..9.
static_assert(UTRO_ADC_GPIO >= 1 && UTRO_ADC_GPIO <= 10,
              "На ESP32-S3 ADC1 выведен только на GPIO1..GPIO10. GPIO11..GPIO20 - это ADC2, он делится с радиоблоком, а GPIO19/20 заняты USB.");
#define UTRO_ADC_CHANNEL ((adc_channel_t)(UTRO_ADC_GPIO - 1))

static_assert(UTRO_RAW_RATE_HZ % UTRO_OUT_RATE_HZ == 0,
              "Сырая частота обязана делиться на выходную нацело, иначе прореживание не даёт ровной выходной сетки.");
static_assert(UTRO_SUM_LEN * UTRO_MAINS_HZ == UTRO_RAW_RATE_HZ,
              "Окно суммирования обязано быть ровно одним периодом сети - на этом держится нуль гребёнки на 50 Гц.");

// Целый делитель триггера АЦП: interval = f_clk/16/2/fs_raw, то есть
// 2 500 000/fs_raw при APB 80 МГц и 5 000 000/fs_raw при PLL_F160M. Если
// хоть одно из двух нецелое, драйвер усечёт делитель и реальная частота
// уедет, причём на какую именно величину — зависит от версии IDF, то есть
// меняется при обновлении ядра. Явно задать источник тактов публичный API
// adc_continuous не позволяет, поэтому единственная защита — частота, у
// которой целые делители при ОБЕИХ раскладках.
#if UTRO_MAINS_HZ == 50u
static_assert(2500000u % UTRO_RAW_RATE_HZ == 0u && 5000000u % UTRO_RAW_RATE_HZ == 0u,
              "Делитель триггера АЦП выйдет нецелым: частота дискретизации будет не той, что объявлена. Выберите fs_raw, делящую нацело и 2500000, и 5000000.");
#else
#warning "Сеть не 50 Гц: целого делителя триггера АЦП НЕ СУЩЕСТВУЕТ. Для 60 Гц сырая частота обязана делиться и на 60 (период сети), и на 200 (выходная сетка), то есть быть кратной 600; а 2500000 = 2^5 * 5^7 и 5000000 = 2^6 * 5^7 множителя 3 не содержат. Частота уедет на 0.16 % или 0.03 %; полагаться можно только на fs_meas из строк # stat / # end, и хост ОБЯЗАН её использовать."
#endif

#if defined(SOC_ADC_SAMPLE_FREQ_THRES_LOW)
static_assert(UTRO_RAW_RATE_HZ >= SOC_ADC_SAMPLE_FREQ_THRES_LOW,
              "Частота АЦП ниже аппаратного минимума.");
#endif
#if defined(SOC_ADC_SAMPLE_FREQ_THRES_HIGH)
static_assert(UTRO_RAW_RATE_HZ <= SOC_ADC_SAMPLE_FREQ_THRES_HIGH,
              "Частота АЦП выше аппаратного максимума.");
#endif

// Вывод меандра не должен совпадать ни с входом АЦП, ни со светодиодом.
static_assert(UTRO_SQ_PIN != UTRO_ADC_GPIO,
              "Вывод калибровочного меандра совпал с входом АЦП.");
#if !UTRO_LED_RGB
static_assert(UTRO_SQ_PIN != UTRO_LED_PIN,
              "Вывод калибровочного меандра совпал с выводом светодиода: индикация и инжекция заряда будут мешать друг другу.");
#endif
#if UTRO_LED_RGB && defined(SOC_GPIO_PIN_COUNT)
static_assert(UTRO_SQ_PIN != (RGB_BUILTIN > SOC_GPIO_PIN_COUNT ? RGB_BUILTIN - SOC_GPIO_PIN_COUNT : RGB_BUILTIN),
              "Вывод калибровочного меандра совпал с линией данных адресного светодиода.");
#endif

// Один кадр DMA = ровно один выходной отсчёт (20 преобразований = 5 мс). Это
// не экономия, а упрощение: прерывание кадра приходит на каждый выходной
// отсчёт, и после любой чистки пула чтение начинается с границы кадра, то
// есть фаза выдачи остаётся кратной 5 мс.
#define UTRO_FRAME_CONVS   UTRO_DECIM
#define UTRO_FRAME_BYTES   (UTRO_FRAME_CONVS * 4u)
#define UTRO_POOL_BYTES    (UTRO_FRAME_BYTES * UTRO_POOL_FRAMES)
#define UTRO_READ_FRAMES   8u
#define UTRO_READ_BYTES    (UTRO_FRAME_BYTES * UTRO_READ_FRAMES)

static_assert(SOC_ADC_DIGI_RESULT_BYTES == 4,
              "Разбор потока DMA написан под 4 байта на преобразование.");

// На S3 результат DMA приходит в формате TYPE2. Поле unit в нём намеренно
// не читается: режим преобразования задан как «только ADC1», и официальный
// пример IDF тоже читает лишь channel и data.
#define UTRO_CONV_CHANNEL(p) ((p)->type2.channel)
#define UTRO_CONV_DATA(p)    ((p)->type2.data)

#if defined(ADC_CALI_SCHEME_CURVE_FITTING_SUPPORTED) && ADC_CALI_SCHEME_CURVE_FITTING_SUPPORTED
#define UTRO_HAVE_CALI 1
#else
#define UTRO_HAVE_CALI 0
#endif

// Поля bits и atten_db в заголовке раньше были литералами "12" и "12", а
// значения задавались макросами: смена ослабления по §6.6 дала бы запись с
// неверными метаданными и неверный пересчёт в вольты, причём незаметно.
// Теперь оба выводятся из макросов, а сборка падает, если ослабление
// изменили, не обновив номинальный размах.
static constexpr int kAdcBits = (UTRO_ADC_BITS == ADC_BITWIDTH_12) ? 12 : -1;
static_assert(kAdcBits == 12,
              "Поле bits в заголовке и UTRO_ADC_MAX написаны под 12 разрядов. У АЦП ESP32-S3 других нет; если появились - правьте и то, и другое.");
static constexpr int kAttenMilliDb =
    (UTRO_ADC_ATTEN == ADC_ATTEN_DB_0)   ? 0 :
    (UTRO_ADC_ATTEN == ADC_ATTEN_DB_2_5) ? 2500 :
    (UTRO_ADC_ATTEN == ADC_ATTEN_DB_6)   ? 6000 :
    (UTRO_ADC_ATTEN == ADC_ATTEN_DB_12)  ? 12000 : -1;
static_assert(kAttenMilliDb == 12000,
              "UTRO_FULL_SCALE_MV = 3100 мВ - это номинальный размах при ослаблении 12 дБ. Меняете ослабление - меняйте и размах, иначе милливольты в отчёте и в файле будут неверны.");

static const double kPi = 3.14159265358979323846;
// Ожидаемое подавление белого шума скользящей суммой: sqrt(80) = 8.944.
static const double kNoiseGain = 8.94427190999916;

// Пороги из АНАЛОГОВЫЙ-ТРАКТ.md, в кодах АЦП. Все числа — РАСЧЁТНЫЕ, их
// надо ИЗМЕРИТЬ на собранном усилителе (см. §8 того же документа).
//   ±1200 мВ рабочего размаха (§2.3) при 0.757 мВ/код = 1585 кодов в каждую
//   сторону, то есть размах 3170 кодов. Выход за него — клиппинг со всеми
//   последствиями: гармоники дыхания прямо в полосе 4–20 Гц.
#define UTRO_PP_LINEAR_MAX 3170.0
//   §6.6: целевой размах дыхания 1850 кодов, приемлемо 1200..2400. В коде
//   нужны только границы приемлемого - цель 1850 это дело процедуры §6.6,
//   а не порог прошивки.
//   ПОЧЕМУ НЕ 1400 И 700..2500, КАК БЫЛО. §6.6 прямо называет прежние
//   пороги прошивки своими старыми числами и предписывает их правку: 1400
//   кодов соответствуют амплитуде дыхания 530 мВ (44 % запаса), а бюджет
//   §2.3 заложен на 700 мВ АМПЛИТУДЫ, то есть 1400 мВ размаха = 1850 кодов.
//   Путаница амплитуды с размахом стоила множителя 2 по усилению: либо
//   дыхание занимает 88 % диапазона и пульс срезается клиппингом на первом
//   же перевороте, либо G занижен вдвое. Прежние пороги были мягче предела,
//   то есть безопасны, но прибор и документ называли человеку разные числа -
//   а источник истины по бюджету размаха один, и он в §2.3.
#define UTRO_PP_HIGH        2400.0
#define UTRO_PP_LOW         1200.0
//   §6.7 п.3 и §4.2: порог наводки задан в СЫРЫХ КОДАХ АЦП, и это не
//   стилистика. 300 мВ бюджета §2.3 стоят на ВЫХОДЕ КАСКАДА 2, а АЦП видит
//   их через фиксированный выходной ФНЧ R7C7: H2(50) = 0.550. Значит
//   бюджетные 300 мВ выглядят в АЦП как 165 мВ = 218 кодов амплитуды, и
//   именно это число §4.2 называет границей линейности, а §6.7 берёт
//   рабочий порог с запасом вдвое: 100 кодов - хорошо, выше 218 - СТОП.
//   Прежний код сравнивал милливольты, посчитанные НА СТОРОНЕ АЦП, прямо с
//   бюджетом 300 мВ на выходе каскада 2 - то есть был в 1/0.550 = 1.8 раза
//   мягче, чем бюджет, и пропускал наводку, уже выведшую каскад 2 из
//   линейности. Порог в кодах вдобавок не зависит от G (300 мВ стоят ПОСЛЕ
//   усилителя) и от калибровки по eFuse.
#define UTRO_MAINS_AMP_GOOD_LSB 100.0
#define UTRO_MAINS_AMP_STOP_LSB 218.0
//   Передача выходного ФНЧ на 50 Гц — для пересчёта измеренной в АЦП
//   наводки обратно к выходу каскада 2, где бюджет §2.3 и задан.
#define UTRO_H2_AT_MAINS     0.550
#define UTRO_MAINS_BUDGET_MV 300.0
//   §6.7: доля 50 Гц в сыром потоке выше 0.3 — наводка доминирует. Это
//   критерий самого документа, и он безразмерный, то есть не зависит ни от
//   калибровки по eFuse, ни от усиления. Определение доли берётся из §6.7
//   буквально: амплитуда 50 Гц, делённая на СКО сырого потока, умноженное
//   на sqrt(2) (в коде §6.7 это amp50/(rms*1.414)).
#define UTRO_MAINS_FRAC_MAX  0.30

// --------------------------------------------------------------------------
// СОСТОЯНИЕ
// --------------------------------------------------------------------------

// Режимы. Намеренно не enum: сборщик Arduino вставляет прототипы функций
// сразу после последнего #include, то есть раньше любого типа, объявленного
// в самом скетче, и сигнатура с собственным типом перестала бы собираться.
#define MODE_IDLE    0u
#define MODE_STREAM  1u
#define MODE_CAL     2u
#define MODE_RAW     3u   // сырой захват 4000 Гц в ОЗУ
#define MODE_DUMP    4u   // выгрузка захваченного; АЦП уже остановлен

static uint8_t g_mode = MODE_IDLE;

static adc_continuous_handle_t g_adc = NULL;
static bool g_adc_ok = false;       // драйвер создан и настроен
static bool g_adc_running = false;

// Ось времени. g_n_out — индекс СЛЕДУЮЩЕГО отсчёта; индекс 0 соответствует
// моменту g_t0_us. Шаг оси: 1/200 с в обычных режимах, 1/4000 с в сыром.
static uint32_t g_n_out = 0;
static int64_t  g_t0_us = 0;
static bool     g_settled = false;     // ожидание установления закончилось
static bool     g_anchored = false;    // ось времени привязана
static uint32_t g_settle_until_ms = 0;
static uint32_t g_settle_tick_ms = 0;

// Скользящая сумма: кольцо на 80 сырых отсчётов и бегущая сумма.
